                <enumeratedValue>
                  <name>3MB</name>
                  <description>Total available System SRAM size is 3MB (SSRAM0, SSRAM1, and SSRAM2).</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
