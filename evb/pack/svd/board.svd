          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AOICVDCURESTRICTIONMASK0</name>
              <description>AO_ICV_DCU_RESTRICTION_MASK [31:0] parameter, that will be a customer modifiable.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOICVDCURESTRICTIONMASK1</name>
          <description>The 'ICV_DCU_restriction_mask' parameter is read by FW during the secure debug verification to prevent OEM from setting specific DCUs that protect ICV secrets</description>
          <addressOffset>0x00001E24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AOICVDCURESTRICTIONMASK1</name>
              <description>AO_ICV_DCU_RESTRICTION_MASK [63:32] parameter, that will be a customer modifiable.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOICVDCURESTRICTIONMASK2</name>
          <description>The 'ICV_DCU_restriction_mask' parameter is read by FW during the secure debug verification to prevent OEM from setting specific DCUs that protect ICV secrets</description>
          <addressOffset>0x00001E28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AOICVDCURESTRICTIONMASK2</name>
              <description>AO_ICV_DCU_RESTRICTION_MASK [95:64] parameter, that will be a customer modifiable.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOICVDCURESTRICTIONMASK3</name>
          <description>The 'ICV_DCU_restriction_mask' parameter is read by FW during the secure debug verification to prevent OEM from setting specific DCUs that protect ICV secrets</description>
          <addressOffset>0x00001E2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AOICVDCURESTRICTIONMASK3</name>
              <description>AO_ICV_DCU_RESTRICTION_MASK [127:96] parameter, that will be a customer modifiable.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOCCSECDEBUGRESET</name>
          <description>The reset-upon-debug indication</description>
          <addressOffset>0x00001E30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>AOCCSECDEBUGRESET</name>
              <description>For resets Cerberus, and prevents loading the HW keys after that reset</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTAOLOCKBITS</name>
          <description>These masks will define, per LCS, which DCU bits will be tied to zero, even if the Host tries to set them. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001E34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000080</resetValue>
          <resetMask>0x000001FF</resetMask>

          <fields>
            <field>
              <name>HOSTDFAENABLELOCK</name>
              <description>When this FW control is set, the DFA_ENABLE register cant be written until the next POR. The DFA_ENABLE_LOCK register is set-once (per POR).</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTFORCEDFAENABLE</name>
              <description>When this FW controlled register is set, the AES DFA countermeasures are enabled_disabled (regardless of the AES_DFA_IS_ON register value).</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RESETUPONDEBUGDISABLE</name>
              <description>The RESET_UPON_DEBUG_DISABLE register is set-once (per POR).</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTICVRMALOCK</name>
              <description>The ICV_RMA_LOCK register is set-once (per POR).</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTKCELOCK</name>
              <description>When this FW controlled register is set, the Kce HW key is masked (to zero).</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTKCPLOCK</name>
              <description>When this FW controlled register is set, the Kcp HW key is masked (to zero).</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTKCEICVLOCK</name>
              <description>When this FW controlled register is set, the Kceicv HW key is masked (to zero).</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTKPICVLOCK</name>
              <description>When this FW controlled register is set, the Kpicv HW key is masked (to zero).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HOSTFATALERR</name>
              <description>When the 'FATAL_ERROR' register is asserted - HW keys will not be copied from OTP</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOAPBFILTERING</name>
          <description>This register holds the AO_APB_FILTERING data. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001E38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <resetMask>0x000003FF</resetMask>

          <fields>
            <field>
              <name>APBCONLYINSTACCESSALLOWLOCK</name>
              <description>when this FW controlled register is set, the APBC_ONLY_INST_ACCESS_ALLOWED register cant be modified (until the next POR)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>APBCONLYINSTACCESSALLOW</name>
              <description>when this FW controlled register is set, the APB-C slave accepts only instruction accesses</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>APBCONLYPRIVACCESSALLOWLOCK</name>
              <description>when this FW controlled register is set, the APBC_ONLY_PRIV_ACCESS_ALLOWED register cant be modified (until the next POR)</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>APBCONLYPRIVACCESSALLOW</name>
              <description>when this FW controlled register is set, the APB-C slave accepts only privileged accesses</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>APBCONLYSECACCESSALLOWLOCK</name>
              <description>when this FW controlled register is set, the APBC_ONLY_SEC_ACCESS_ALLOWED register cant be modified (until the next POR).</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>APBCONLYSECACCESSALLOW</name>
              <description>when this FW controlled register is set, the APB-C slave accepts only secure accesses</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ONLYPRIVACCESSALLOWLOCK</name>
              <description>when this FW controlled register is set, the APBC_ONLY_PRIV_ACCESS_ALLOWED register cant be modified (until the next POR)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ONLYPRIVACCESSALLOW</name>
              <description>when this FW controlled register is set, the APB slave accepts only privileged accesses</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ONLYSECACCESSALLOWLOCK</name>
              <description>when this FW controlled register is set, the ONLY_SEC_ACCESS_ALLOWED register cant be modified (until the next POR).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ONLYSECACCESSALLOW</name>
              <description>when this FW controlled register is set, the APB slave accepts only secure accesses</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AOCCGPPC</name>
          <description>holds the AO_CC_GPPC value from AONote: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001E3C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
            <field>
              <name>AOCCGPPC</name>
              <description>The AO_CC_GPPC value</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTRGFCCSWRST</name>
          <description>Writing to this register generates a general reset to CryptoCell. This reset takes about 4 core clock cycles.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001E40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTRGFCCSWRST</name>
              <description>Writing 1 to this field generates a general reset to CryptoCell.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AIBFUSEPROGCOMPLETED</name>
          <description>This register reflects the fuse_aib_prog_completed input, which indicates that the fuse programming was completed.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>AIBFUSEPROGCOMPLETED</name>
              <description>Indicates if the fuse programming operation has been completed.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NVMDEBUGSTATUS</name>
          <description>AIB debug status register. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000E</resetValue>
          <resetMask>0x0000000E</resetMask>

          <fields>
            <field>
              <name>NVMSM</name>
              <description>Main nvm fsm</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>IDLE NVMSM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_DUMMY</name>
                  <description>READ_DUMMY NVMSM</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_MAN_FLAG</name>
                  <description>READ_MAN_FLAG NVMSM</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_OEM_FLAG</name>
                  <description>READ_OEM_FLAG NVMSM</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_GPPC</name>
                  <description>READ_GPPC NVMSM</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DECODE</name>
                  <description>DECODE NVMSM</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OTP_LCS_VALID</name>
                  <description>OTP_LCS_VALID NVMSM</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LCS_IS_VALID</name>
                  <description>LCS_IS_VALID NVMSM</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>LCSISVALID</name>
          <description>Indicates that the LCS register holds a valid value.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>LCSISVALIDREG</name>
              <description>Indicates whether LCS is valid.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>NVMISIDLE</name>
          <description>Indicates that the LCS register holds a valid value.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>NVMISIDLEREG</name>
              <description>Indicates whether the NVM manager finishes its operation, calculates the LCS, reads the HW keys, compares the number of zeros and clears the keys</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LCSREG</name>
          <description>The lifecycle state register. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001F07</resetMask>

          <fields>
            <field>
              <name>ERRORKCEICVZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KCEICV is not equal to the value set in the manufacture flag.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORKPICVZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KPICV is not equal to the value set in the manufacture flag.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORKCEZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KCE is not equal to the value set in the OEM flag.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORPROVZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KCP is not equal to the value set in the OEM flag.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ERRORKDRZEROCNT</name>
              <description>Indication that the number of zeroes in the loaded KDR is not equal to the value set in the manufacture flag.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LCSREG</name>
              <description>Indicates the LCS (Lifecycle State) value.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CM</name>
                  <description>CM lifecycle state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DM</name>
                  <description>DM lifecycle state</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SE</name>
                  <description>SE lifecycle state</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RMA</name>
                  <description>RMA lifecycle state</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKDRREG</name>
          <description>This register interface is used to update the RKEK(KDR) registers when the device is in CM or DM mode , it is Write-once (per warm boot) in RMA LCS, The RKEK is updated by shifting .</description>
          <addressOffset>0x00001F18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKDRREG</name>
              <description>This field is used to update the KDR registers when the device is in CM , DM or RMA mode, The KDR is updated by shifting .</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKCPREG</name>
          <description>This register interface is used to update the KCP registers when the device is in CM or DM mode, The KCP is updated by shifting</description>
          <addressOffset>0x00001F1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKCPREG</name>
              <description>This field is used to update the KCP registers when the device is in CM or DM mode, The KCP is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKCEREG</name>
          <description>This register interface is used to update the KCE registers when the device is in CM or DM mode, The KCE is updated by shifting</description>
          <addressOffset>0x00001F20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKCEREG</name>
              <description>This field is used to update the KCE registers when the device is in CM or DM mode, The KCE is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKPICVREG</name>
          <description>This register interface is used to update the KPICV registers when the device is in CM or DM mode, The KPICV is updated by shifting</description>
          <addressOffset>0x00001F24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKPICVREG</name>
              <description>This field is used to update the KPICV registers when the device is in CM or DM mode, The KPICV is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HOSTSHADOWKCEICVREG</name>
          <description>This register interface is used to update the KCEICV registers when the device is in CM or DM mode, The KCEICV is updated by shifting</description>
          <addressOffset>0x00001F28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HOSTSHADOWKCEICVREG</name>
              <description>This field is used to update the KCEICV registers when the device is in CM or DM mode, The KCEICV is updated by shifting</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>OTPADDRWIDTHDEF</name>
          <description>OTP_ADDR_WIDTH parameter, that will define the integrated OTP address width (address in words). The supported sizes are 6 (for 2 Kbits),7,8,9,11 (for 64 Kbits). The default value in the provided RTL will be 6.Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00001F2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000B</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>OTPADDRWIDTHDEF</name>
              <description>Holds the OTP_ADDR_WIDTH_DEF value.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DC</name>
      <version>1.0</version>
      <description>Display Controller</description>
      <!-- <groupName>GROUP_DC</groupName> -->
      <baseAddress>0x400A0000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x00001C04</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DC</name>
        <description>DC_IRQ</description>
        <value>29</value>
      </interrupt>
      <registers>
        <register>
          <name>MODE</name>
          <description>General control register that activates the NEMAp|dc400  controller and various parameters, sets the timing signals'  polarity, activates the global look-up table for gamma correction and chooses the output display formats to meet LCD color specifications.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>ENABLE</name>
              <description>When set to 1, the dc400  controller is activated</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PRGCUREN</name>
              <description>When set to 1, programmable cursor is enabled</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSVD029</name>
              <description>This field is reserved.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VSYNCPOL</name>
              <description>Defines VSYNC polarity</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VSYNC_NEG</name>
                  <description>VSYNC polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VSYNC_POS</name>
                  <description>VSYNC polarity is positive</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSYNCPOL</name>
              <description>Defines HSYNC polarity</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HSYNC_NEG</name>
                  <description>HSYNC polarity is negative</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSYNC_POS</name>
