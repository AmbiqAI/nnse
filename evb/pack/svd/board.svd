          <fields>
            <field>
              <name>HASHH6</name>
              <description>1) Write initial Hash value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHH7</name>
          <description>H7 data. can only be written in the following HASH_CONTROL modes: SHA224 SHA256 SHA384 SHA512</description>
          <addressOffset>0x0000065C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HASHH7</name>
              <description>1) Write initial Hash value.</description>
              <bitRange>[31:0]</bitRange>
