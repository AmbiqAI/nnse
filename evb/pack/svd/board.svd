              <name>STATUF</name>
              <description>Indicates current underflow</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>STATLAST</name>
              <description>Indicates that the last row is currently displayed</description>
