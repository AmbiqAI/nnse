        <register>
          <name>L2LUT0</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255] Layer 2 palette,gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L2LUT(n) (*((volatile uint32_t*)(&amp;L2LUT + (4*n))))</description>
          <addressOffset>0x00001800</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L2LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L2LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>L3LUT</name>
          <description>A[0]R[0]G[0]B[0] thru A[255]R[255]G[255]B[255] Layer 3 palette,gamma correction memory region where x starts at 0 thru 255.Access to all 256 registers is best accomplished by passing an index via a macro. e.g. pseudocode  #define DC_L3LUT(n) (*((volatile uint32_t*)(&amp;L3LUT + (4*n))))</description>
          <addressOffset>0x00001C00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>L3LUT0GAMRAMPA</name>
              <description>Gamma ramp alpha bits</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPR</name>
              <description>Gamma ramp red bits</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPG</name>
              <description>Gamma ramp green bits</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>L3LUT0GAMRAMPB</name>
              <description>Gamma ramp blue bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DSI</name>
      <version>1.0</version>
      <description>Digital Serial Interface Unit</description>
      <!-- <groupName>GROUP_DSI</groupName> -->
      <baseAddress>0x400A8000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0</offset>
        <size>0x000000A4</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DSI</name>
        <description>DSI_IRQ</description>
        <value>30</value>
      </interrupt>
      <registers>
        <register>
          <name>DEVICEREADY</name>
          <description>Devide Ready register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>

          <fields>
            <field>
              <name>DISPLAYBUSPOSSESSEN</name>
              <description>Inform DSI receiver has to be given the bus possession for receiving the tearing effect trigger message; Reset by the processor to stop the bus possession of the DSI receiver; Note: Tearing effect is supported only in Type1; Display Architecture (command mode only) as suggested by Display Command Set Specification; Note1: Even if the processor does not clear the display_bus_possession bit after receiving the interrupt for tearing effect, DSI-tx controller starts the activities on the DSI link once the TE trigger message is received</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ULPS</name>
              <description>FIXME - Bitfield description needed here.</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW_POWER</name>
                  <description>This pattern is set by the processor to inform that entire DSI host is to be put on ultra low power [POWER SAVING] mode 01 - This pattern is set by the processor to inform</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXIT</name>
                  <description>This pattern is set by the processor to inform that entire DSI host is to be pu on ultr low power EXIT mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>This</name>
                  <description>pattern is set by the processor to make the DSI host come out of the wakeup time and resume the normal operation if the DSI Host already remains in the ULPS exit state. S/W needs to ensure that there is a minimum of 1ms time available before clearing the UPLS exit State. 1(a). In DPI Only Mode: No DPI traffic should be sent after the above patterns like 10 or 01 is set in this register. Device_ready bit in Device Ready register should not be disturbed or should remain set while the device is subjected to ULPS states. 1(b). In Dual Display Mode: DPI Interface has to be disabled and also no DBI traffic should be sent after the above patterns like 10 or 01 is set in this register. Device_ready bit in Device Ready register should not be disturbed or should remain set while the device is subjected to ULPS states.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>READY</name>
              <description>Ready for programming after all count registers and timeout.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PROGRAMMED</name>
                  <description>Set to 1 after dphy_parameter register, all the count registers, and timeout and interrupt enable registers are being programmed.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Set by the processor to inform that device is ready for transmission. This register should be set to 1 after dphy_parameter register, all the count registers, and timeout and interrupt enable registers are being programmed. Note: Reprogramming the registers by resetting the device_ready bit results in re-enumeration of the DSI controller from the power up sequence.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>INTRSTAT</name>
          <description>The interrupt status register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DPIPRGERR</name>
              <description>(RW1C) Set to 1 indicates that the error in DPI parameters programming</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPILINETO</name>
              <description>(RW1C) DPI line time out. Set to 1 indicates that the line time out during the DPI transfer</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCNT</name>
              <description>(RW1C) Rx Contention; Set to 1 if contention detected in the display</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INITDONE</name>
              <description>(RW1C) Set 1 indicates that the DSI initialization is done. DSI        Tx is ready to accept the DPI or DBI or Generic transfer</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SPECIALPACK</name>
              <description>(RW1C) Special packet command sent; Set to confirm the transmission of the DPI event specific commands set in the dpi control and dpi data</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXDSIPROT</name>
              <description>(RW1C) Rx DSI protocol violation; Set if acknowledge short packet shows DSI protocol violation error</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXINVALID</name>
              <description>(RW1C) Rx Invalid; Set if acknowledge short packet shows an invalid transmission count</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACKWNOERR</name>
              <description>(RW1C) T  ACK_with No_error; Set if acknowledge trigger message is received with out any error.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TURNARNDACK</name>
              <description>(RW1C) Turn around acknowledge. Set if a turn around acknowledgement sequence is timeout not received from the display device</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPRXTIMEOUT</name>
              <description>(RW1C) Set if a low power reception count expires this interrupt is generated</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTXTIMEOUT</name>
              <description>(RW1C) Set if a high speed transmission prevails for more than the expected count value this interrupt is raised</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFOEMPTY</name>
              <description>(RW1C) Set to 1 if all FIFOs are empty</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LOWC</name>
              <description>(RW1C) Low contention; Set to 1 if a LP low fault is registered by at the D-PHY contention detector. If this interrupt is set device should be re-enumerated</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HIGHC</name>
              <description>(RW1C) High contention;Set to 1 if a LP high fault is registered by at the D-PHY contention detector. If this interrupt is set device should be re-enumerated</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSII</name>
              <description>(RW1C) TxDSI VC ID invalid; Set to 1 if the received virtual channel ID is invalid</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSIN</name>
              <description>(RW1C) TxDSI data type not recognised; Set to 1 if the received data type is not recognised</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXCHECKSUM</name>
              <description>(RW1C) Txchecksum error; Set to 1 if the computed CRC differs from the received CRC value during the reception of packets by Arasan_DSI host</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXECCM</name>
              <description>(RW1C) Set to 1 if there is no ECC correction for the packet or there are more than 2 bit errors in the packet received by Arasan_DSI_host.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXECCS</name>
              <description>(RW1C) Set to 1 if ECC syndrome was computed and is corrected for one bit error during the reception of packets by the Arasan_DSI_host.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXFALSECNTRL</name>
              <description>(RW1C) TxFalse Control Error; Set to 1 if a control error is observed on the lanes by the Arasan_DSI_host</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIDI</name>
              <description>(RW1C) RxDSI VC ID invalid; Set to 1 if the virtual channel ID is invalid by the display device is reported in the Acknowledge packet by the display device</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSINR</name>
              <description>(RW1C) RxDSI data type not recognised; Set to 1 if the data type is not recognised by the display device is reported in the Acknowledge packet by the display device</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCHECKSUM</name>
              <description>(RW1C) Set to 1 if the computed CRC differs from the received CRC value and is reported in the acknowledge packet by the display device</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxECCM</name>
              <description>(RW1C) RxECC multibit error; Set to 1 if there is no ECC correction for the packet or there are more than 2 bit errors in the packet isreported in the Acknowledge packet by the display device</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxECCS</name>
              <description>(RW1C) RRxECC single bit error; Set to 1 if ECC syndrome was computed and corrected for one bit error is reported in the Acknowledge packet by the display device</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXFALSECNTRL</name>
              <description>(RW1C) RxFalse Control Error; Set to 1 if a control error is reported in the acknowledge packet by the display device</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXPERIPHERAL</name>
              <description>(RW1C) Rx Peripheral timeout Error; Set to 1 if the high speed receive timer value or LP Tx timer value are expired, display device is reported in the Acknowledge packet</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXLPTXSYNCERR</name>
              <description>(RW1C) Rx LP tx sync error; Set to 1 if Low power transmission sync error occurs in the display device and is reported in the Acknowledge packet by the display device</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXESCAPEMODE</name>
              <description>(RW1C) Entry Error;  Set to 1 if Escape Mode Entry command is not understandable by the display device and is reported in the Acknowledge packet by the display device.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXEOTSYNCERROR</name>
              <description>(RW1C) Set to 1 if End of transmission synchronisation Error is reported in the acknowledgment packet by the display device</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTSYNCERROR</name>
              <description>(RW1C) Set to 1 if synchronisation error occurrence in the   start of transmission sequence is reported in the acknowledge packet by the display device</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTERROR</name>
              <description>(RW1C) Set to 1 if a start of transmission sequence error is reported in the Acknowledge packet by the display device</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTREN</name>
          <description>Interrupt enable register.</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>DPI</name>
              <description>PGRMERR     DPI program error; Set to 1 indicates that the error in DPI parameters programming</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPILINETO</name>
              <description>Dpi line timeout; Set to 1 indicates that the line time out during the DPI transfer</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCONTENT</name>
              <description>Detected  Rx Contention Detected; Set to enable the interrupt for contention detected error in the acknowledgment packet reports</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INITDONE</name>
              <description>Set 1 indicates that the DSI initialisation is done DSI Tx is ready to accept the DPI or DBI or Generic transfer</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SPECIALPACK</name>
              <description>Special packet command sent; Set to enable the confirmation interrupt for transmitting DPI events set in the dpi data and dpi control registers</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXDSI</name>
              <description>Rx DSI protocol violation; Set to enable DSI protocol violation error</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXINV</name>
              <description>Rx Invalid transmission count error; Set to enable acknowledge invalid transmission counterror</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACKWITHNOERR</name>
              <description>ACK with No_error; Set to enable acknowledge trigger message reception with out any error</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TURNARNDACK</name>
              <description>Set to enable turn around acknowledgement sequence timeout</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPRXTIMEOUT</name>
              <description>Set to enable low power reception count timeouts</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HSTXTIMEOUT</name>
              <description>Set to enable a high speed transmission timeout</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFOEMPTY</name>
              <description>Set to enable a FIFO empty interrupt</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LOWC</name>
              <description>Low contention; Set to enable a LP low fault interrupt</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HIGHC</name>
              <description>High contention; Set to enable a LP high fault interrupt</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSIV</name>
              <description>TxDSI VC ID invalid; Set to enable the interrupt if the received packets virtual channel ID is invalid</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxDSID</name>
              <description>TxDSI data type not recognised; Set to enable the interrupt if the received packets data type is not recognised</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TXCHCKSUM</name>
              <description>Txchecksum error; Set to enable the interrupt if the computed CRC differs from the received CRC value for the received packets</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxECCM</name>
              <description>TxECC multibit; Set to enable the interrupt if there is no ECC correction for the packet or there are more than 2 bit errors in the packet received by Arasan DSI host</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxECCS</name>
              <description>TxECC single bit; Set to enable the interrupt if ECC syndrome was computed and is corrected for one bit error during the reception of packets by the Arasan DSI Host</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TxFalseCntrl</name>
              <description>TxFalse Control; Set to enable the interrupt for the control error observed on the lanes by the Arasan_DSI_host</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIV</name>
              <description>RxDSI VC ID invalid virtual channel; Set to enable the interrupt for invalid ID in the acknowledgment packet reports</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RxDSIData</name>
              <description>RxDSI data type not recognised; Set to enable the interrupt for the un recognised data type in the acknowledgment packet reports</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCHECKSUM</name>
              <description>Rxchecksum error; Set to enable the interrupt for the computed CRC differs from the received CRC value in the acknowledgment packet reports</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXECCM</name>
              <description>RxECC multibit error; Set to enable the interrupt for no ECC correction for the packet or there are more than 2 bit errors reported in the acknowledgment packet</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXECCS</name>
              <description>RxECC single bit error; Set to enable the interrupt for ECC syndrome computation and one bit error correction for the acknowledgment packet</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXFALSE</name>
              <description>RxFalse Control error; set to enable the interrupt for control error in the acknowledgment packet reports.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXPERIPHRCVTOE</name>
              <description>Peripheral receive timeout Error; Set to enable the interrupt for the high speed timeout Error or Lp tx timeout error in the acknowledgment packet reports</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXLPTXSYNCERR</name>
              <description>Rx LP tx sync error; Set to enable the interrupt for Low power transmission sync error in the acknowledgment packet reports</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXESCPMDETRYERR</name>
              <description>RxEscape Mode Entry Error; Set to enable the interrupt for Escape Mode Entry command error in the acknowledgment packet reports</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXEOTSYNCRR</name>
              <description>RxEot Sync Error l set to enable the interrupt for the end of transmission synchronisation Error in the acknowledgment packet reports</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTSYNCERROR</name>
              <description>RX start of transmission; Set to enable the interrupt for start of transmission synchronization error in the acknowledgement packet reports</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSOTERROR</name>
              <description>RX start of transmission; set to enable the interrupt for start of transmission</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DSIFUNCPRG</name>
          <description>DSI function programming register</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x0000E3FF</resetMask>

          <fields>
            <field>
              <name>REGNAME</name>
              <description>FIXME - Bitfield description needed here.</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
