        <register>
          <name>HOSTCRYPTOKEYSEL</name>
          <description>AES hardware key select. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00000A38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>

          <fields>
            <field>
              <name>SELCRYPTOKEY</name>
              <description>Select the source of the HW key that is used by the AES engine:</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RKEK</name>
                  <description>rkek</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Krtl</name>
                  <description>the Krtl.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KCP</name>
                  <description>the provision key KCP.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KCE</name>
                  <description>the code encryption key KCE.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KPICV</name>
                  <description>the KPICV, The ICV provisioning key .</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KCEICV</name>
                  <description>the code encryption key KCEICV Note: When 'kprtl_lock' is set - kprtl will be masked (trying to load it will load zeros to the AES key register. When 'kcertl_lock' is set - kcertl will be masked (trying to load it will load zeros to the AES key register. When scan_mode is asserted all the RTL keys (Krtll) will be masked.</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HOSTCORECLKGATINGENABLE</name>
