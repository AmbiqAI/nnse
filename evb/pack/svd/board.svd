        </register>
        <register>
          <name>VRSTATUS</name>
          <description>Provides BUCK and LDOs status.</description>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>SIMOBUCKST</name>
              <description>Indicates SIMO BUCK status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the SIMO BUCK is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the SIMO BUCK is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the SIMO BUCK is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MEMLDOST</name>
              <description>Indicates MEMLDO status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the MEMLDO is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the MEMLDO is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the MEMLDO is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CORELDOST</name>
              <description>Indicates CORELDO status. bit[1] indicates ON/OFF and bit[0] indicates ACT/LP.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Indicates the the CORELDO is OFF.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LP</name>
                  <description>Indicates the the CORELDO is ON and in LP mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACT</name>
                  <description>Indicates the the CORELDO is ON and in ACT mode.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMCTRL</name>
          <description>This register provides additional fine-tune power management controls for the SRAMs and the SRAM controller. This includes enabling light sleep for the SRAM and TCM banks, and clock gating for reduced dynamic power.</description>
          <addressOffset>0x00000190</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFF06</resetMask>

          <fields>
            <field>
              <name>SRAMLIGHTSLEEP</name>
              <description>Light Sleep enable for each TCM/SRAM bank. When 1, corresponding bank will be put into light sleep. For optimal power, banks should be put into light sleep while the system is active but the bank has minimal or no accesses.</description>
              <bitRange>[31:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>Enable LIGHT SLEEP for ALL SRAMs</description>
                  <value>4095</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disables LIGHT SLEEP for ALL SRAMs</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SRAMMASTERCLKGATE</name>
              <description>This bit is 1 when the master clock gate is enabled (top-level clock gate for entire SRAM block)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable Master SRAM Clock Gate</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disables Master SRAM Clock Gating</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SRAMCLKGATE</name>
              <description>This bit is 1 if clock gating is allowed for individual system SRAMs</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable Individual SRAM Clock Gating</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disables Individual SRAM Clock Gating</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ADCSTATUS</name>
          <description>This provides the power status for various blocks within the ADC. These status comes directly from the ADC module and is captured through this interface.</description>
          <addressOffset>0x00000194</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>REFBUFPWD</name>
              <description>This bit indicates that the ADC REFBUF is powered down</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>REFKEEPPWD</name>
              <description>This bit indicates that the ADC REFKEEP is powered down</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VBATPWD</name>
              <description>This bit indicates that the ADC VBAT resistor divider is powered down</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VPTATPWD</name>
              <description>This bit indicates that the ADC temperature sensor input buffer is powered down</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>BGTPWD</name>
              <description>This bit indicates that the ADC Band Gap is powered down</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ADCPWD</name>
              <description>This bit indicates that the ADC is powered down</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AUDADCSTATUS</name>
          <description>This provides the power status for various blocks within the audio ADC. These status comes directly from the audio ADC module and is captured through this interface.</description>
          <addressOffset>0x00000198</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000003F</resetValue>
          <resetMask>0x0000003F</resetMask>

          <fields>
            <field>
              <name>AUDREFBUFPWD</name>
              <description>This bit indicates that the ADC REFBUF is powered down</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDREFKEEPPWD</name>
              <description>This bit indicates that the ADC REFKEEP is powered down</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDVBATPWD</name>
              <description>This bit indicates that the ADC VBAT resistor divider is powered down</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDVPTATPWD</name>
              <description>This bit indicates that the ADC temperature sensor input buffer is powered down</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDBGTPWD</name>
              <description>This bit indicates that the ADC Band Gap is powered down</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>AUDADCPWD</name>
              <description>This bit indicates that the ADC is powered down</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TONCNTRCTRL</name>
          <description>Controls each of the ton counters</description>
          <addressOffset>0x000001A0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF1F03</resetMask>

          <fields>
            <field>
              <name>FCNT</name>
              <description>frame width for ton counters</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CLKDIV</name>
              <description>frame width for ton counters</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPMODESWOVR</name>
              <description>lp mode sw override</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ENABLELPOVR</name>
              <description>vdds lp mode override enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRTHRESHVDDS</name>
          <description>Low power override threshold for VDDS</description>
          <addressOffset>0x000001A4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LPOVRTHRESHVDDS</name>
              <description>vdds lp override threshold for ton counter comparator</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRHYSTCNT</name>
          <description>Low power override hysteresis count</description>
          <addressOffset>0x000001A8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LPOVRHYSTCNT</name>
              <description>lp hysteresis count</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRTHRESHVDDF</name>
          <description>Low power override for VDDF</description>
          <addressOffset>0x000001AC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LPOVRTHRESHVDDF</name>
              <description>vddf lp override threshold for ton counter comparator</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRTHRESHVDDC</name>
          <description>Low power override for VDDC</description>
          <addressOffset>0x000001B4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LPOVRTHRESHVDDC</name>
              <description>vddc lp override threshold for ton counter comparator</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRTHRESHVDDCLV</name>
          <description>Low power override for VDDC_LV</description>
          <addressOffset>0x000001BC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>LPOVRTHRESHVDDCLV</name>
              <description>vddc_lv lp override threshold for ton counter comparator</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LPOVRSTAT</name>
          <description>Low power override status register</description>
          <addressOffset>0x000001C4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>LPOVRTRIG</name>
              <description>VDDS LP override has been triggered; write 1 to clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>MRAMEXTCTRL</name>
          <description>MRAM control register</description>
          <addressOffset>0x000001C8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>MRAMLPRDYNAMIC</name>
              <description>bypass lpr dynamic mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MRAMHARDRECALL</name>
              <description>over write send recall command from hardware side</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MRAMAUTOWAKEUPCTRL</name>
              <description>over write rst_auto_wk for TMC IP. auto wake up is enabled at default. write 0x3 to this field to disable the auto wake up.</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MRAMTMCCLKGATDIS</name>
              <description>disable last tmc_clk/tmc_clk_inv clock gate</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EMONCTRL</name>
          <description>Controls each of the energy monitor conuters</description>
          <addressOffset>0x00000200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>CLEAR</name>
              <description>Clear the counter. Each bit corresponds to a counter. 0: Let the counter run run on its input clk. 1: Clear the counter</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FREEZE</name>
              <description>Freeze the counter. Each bit corresponds to a counter. 0: Let the counter run. 1: Stop the counter.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>EMONCFG0</name>
          <description>The counter increments when the counter is enabled and the mode selected here matches the power mode.</description>
          <addressOffset>0x00000204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
            <field>
              <name>EMONSEL0</name>
              <description>Power modes for incrementing the counter</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NEVER</name>
                  <description>Never increment the counter</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALWAYS</name>
                  <description>Always increment the counter</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCUSLEEP</name>
                  <description>Increment the counter for MCU sleep mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCUDEEPSLEEP</name>
                  <description>Increment the counter for MCU deepsleep mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>EMONCFG1</name>
          <description>The counter increments when the counter is enabled and the mode selected here matches the power mode.</description>
          <addressOffset>0x00000208</addressOffset>
          <size>32</size>
          <access>read-write</access>
