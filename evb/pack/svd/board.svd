              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Out Endpoint interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
