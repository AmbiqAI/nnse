              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WULIM</name>
          <description>Sets the window comparator upper limit</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000FFFFF</resetMask>

          <fields>
            <field>
              <name>ULIM</name>
              <description>Sets the upper limit for the window comparator.</description>
              <bitRange>[19:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>WLLIM</name>
          <description>Sets the window comparator lower limit</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000FFFFF</resetMask>

          <fields>
            <field>
              <name>LLIM</name>
              <description>Sets the lower limit for the window comparator.</description>
              <bitRange>[19:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SCWLIM</name>
          <description>Sets the scaling limits for the window comparator</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>SCWLIMEN</name>
              <description>Scale the window limits compare values per precision mode. When set to 0x0 (default), the values in the 20-bit limits registers will compare directly with the FIFO values regardless of the precision mode the slot is configured to. When set to 0x1, the compare values will be divided by the difference in precision bits while performing the window limit comparisons.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO</name>
          <description>The ADC FIFO Register contains up to 2 samples for a single channel (high and low gain PGA samples), each sample up to 12-bits.  It also contains meta data in the form of which audio channel the sample(s) are from along with the PGA gain code for that sample pair.  When no data is present, FIFO entry reads back as all 1s (0xFFFFFFFF).</description>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HGDATA</name>
              <description>High-gain PGA sample data</description>
              <bitRange>[31:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MIC</name>
              <description>Which audio channel this data is from encoded as int(slot number/2).  In other words, this is 1 if data is from slots 2 or 3, or 0 if from slots 0 or 1.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>METAHI</name>
              <description>Meta data about this sample which represents the upper 3 bits of the PGA gain code</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LGDATA</name>
              <description>Low-gain PGA sample data</description>
              <bitRange>[15:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>METALO</name>
              <description>Meta data about this sample which represents the lower 4 bits of the PGA gain code</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFOPR</name>
          <description>This is a pop-on-read mirrored copy of the ADCFIFO register with the only difference being that reading this register will result in a simultaneous FIFO POP which is also achieved by writing to the ADCFIFO Register. Note: The DFIFORDEN bit must be set in the CFG register for the the destructive read to be enabled.</description>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HGDATAPR</name>
              <description>High-gain PGA sample data</description>
              <bitRange>[31:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MICPR</name>
              <description>Which audio channel this data is from encoded as int(slot number/2).  In other words, this is 1 if data is from slots 2 or 3, or 0 if from slots 0 or 1.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>METAHIPR</name>
              <description>Meta data about this sample which represents the upper 3 bits of the PGA gain code</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LGDATAPR</name>
              <description>Low-gain PGA sample data</description>
              <bitRange>[15:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>METALOPR</name>
              <description>Meta data about this sample which represents the lower 4 bits of the PGA gain code</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTTRIGTIMER</name>
          <description>Configures the clock, maximum count, and enables the ADC internal repeating trigger timer.</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x800703FF</resetMask>

          <fields>
            <field>
              <name>TIMEREN</name>
              <description>ADC-internal trigger timer enable.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable the ADC-internal trigger timer.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable the ADC-internal trigger timer.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKDIV</name>
              <description>Configure number of divide-by-2 of clock source as input to the trigger counter up to divide-by-32.  To update this value, first disable the INTTRIGTIMER by setting TIMEREN to DIS, change CLKDIV, and then reenable itthe INTTRIGTIMER by setting TIMEREN to EN again.</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV1</name>
                  <description>Divide input clock by 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV2</name>
                  <description>Divide input clock by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>Divide input clock by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV8</name>
                  <description>Divide input clock by 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV16</name>
                  <description>Divide input clock by 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV32</name>
                  <description>Divide input clock by 32</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TIMERMAX</name>
              <description>Trigger counter count max, used as initial condition to trigger. Also used repeatedly each time counter reaches it to restart trigger timer at zero. To update this value, first disable the INTTRIGTIMER by setting TIMEREN to DIS, change TIMERMAX, and then reenable it INTTRIGTIMER by setting TIMEREN to EN again.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFOSTAT</name>
          <description>This register contains status of the data FIFO.</description>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
            <field>
              <name>FIFOCNT</name>
              <description>Number of valid entries in the ADC FIFO.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DATAOFFSET</name>
          <description>Sample offset value</description>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001FFF</resetMask>

          <fields>
            <field>
              <name>OFFSET</name>
              <description>Add this signed offset to data before being written to the FIFO.  This enables the user to convert unsigned samples to signed or remove a DC offset on the samples.  Note that this does NOT affect the comparator limits, which still operate on original unsigned samples.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ZXCFG</name>
          <description>Configures the zero crossing comparator</description>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000011</resetMask>

          <fields>
            <field>
              <name>ZXCHANSEL</name>
              <description>Select which slots to use for zero crossing measurement.  0 enables zero crossing detection on slots 0 and 2.  1 enables zero crossing detection on slots 1 and 3.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ZXEN</name>
              <description>Enable the ZX comparator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ZXLIM</name>
          <description>Configures the zero crossing comparator limits</description>
          <addressOffset>0x00000064</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0FFF0FFF</resetMask>

          <fields>
            <field>
              <name>UZXC</name>
              <description>Sets the upper integer sample limit for the ZX comparator.  Note that these values are raw ADC values whose bounds are specified by PRMODE but not maniupulated by accumulate/divide logic.  Therefore, there is no oversampling and no binary point in this value.  Samples must enter the range between UZXC and LZXC in order for a zero crossing to be recognized.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LZXC</name>
              <description>Sets the lower integer sample limit for the ZX comparator.  Note that these values are raw ADC values whose bounds are specified by PRMODE but not maniupulated by accumulate/divide logic.  Therefore, there is no oversampling and no binary point in this value.  Samples must enter the range between UZXC and LZXC in order for a zero crossing to be recognized.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>GAINCFG</name>
          <description>Configures the PGA gain</description>
          <addressOffset>0x00000068</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000011</resetMask>

          <fields>
            <field>
              <name>UPDATEMODE</name>
              <description>PGA update mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IMMED</name>
                  <description>Immediate update mode.  Once gain is written, it is immediately encoded and provided to the PGA.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ZX</name>
                  <description>Update gain only at detected zero crossing as configured by ZX registers.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PGACTRLEN</name>
              <description>Enable PGA gain updates.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>GAIN</name>
          <description>Specifies the high gain code</description>
          <addressOffset>0x0000006C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x7F7F7F7F</resetMask>

          <fields>
            <field>
              <name>HGBDELTA</name>
              <description>Specifies the high gain code as an delta from the LGB field for channel B (slot 3).</description>
              <bitRange>[30:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LGB</name>
              <description>Specifies the low gain code (0 to 102 decimal specifies -6.0 dB to 45.0 dB in half-dB increments) for channel B (slot 2).</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HGADELTA</name>
              <description>Specifies the high gain code as an delta from the LGA field for channel A (slot 1).</description>
              <bitRange>[14:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LGA</name>
              <description>Specifies the low gain code (0 to 102 decimal specifies -6.0 dB to 45.0 dB in half-dB increments) for channel A (slot 0).</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SATCFG</name>
          <description>Configure the saturation comparator</description>
          <addressOffset>0x000000A4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000011</resetMask>

          <fields>
            <field>
              <name>SATCHANSEL</name>
              <description>Select which slots to use for saturation measurement.  0 enables saturation on slots 0 and 2.  1 enables saturation on slots 1 and 3.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SATEN</name>
              <description>Enable the saturation comparator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SATLIM</name>
          <description>Sets the saturation comparator limits</description>
          <addressOffset>0x000000A8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0FFF0FFF</resetMask>

          <fields>
            <field>
              <name>USATC</name>
              <description>Sets the upper integer sample limit for the saturation comparator.  Note that these values are raw ADC values whose bounds are specified by PRMODE but not manipulated by accumulate/divide logic.  Therefore, there is no oversampling and no binary point in this value.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LSATC</name>
              <description>Sets the lower integer sample limit for the saturation comparator.  Note that these values are raw ADC values whose bounds are specified by PRMODE but not manipulated by accumulate/divide logic.  Therefore, there is no oversampling and no binary point in this value.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SATMAX</name>
          <description>Sets the limits for saturation comparator event counter</description>
          <addressOffset>0x000000AC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010001</resetValue>
          <resetMask>0x0FFF0FFF</resetMask>

          <fields>
            <field>
              <name>SATCBMAX</name>
              <description>Sets the number of saturation events that may occur before a SATCB interrupt occurs.  Once this interrupt occurs, the saturation event counter must be cleared by writing the SATCLR register.  A value of 0 is invalid and will cause the saturation interrupt to assert immediately.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SATCAMAX</name>
              <description>Sets the number of saturation events that may occur before a SATCA interrupt occurs.  Once this interrupt occurs, the saturation event counter must be cleared by writing the SATCLR register.  A value of 0 is invalid and will cause the saturation interrupt to assert immediately.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SATCLR</name>
          <description>Clears the saturation event counter registers</description>
          <addressOffset>0x000000B0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>SATCBCLR</name>
              <description>Clear saturation event counter register for channel B (slots 2 or 3, depending on SATCHANSEL)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SATCACLR</name>
              <description>Clear saturation event counter register for channel A (slots 0 or 1, depending on SATCHANSEL)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INTEN</name>
          <description>Set bits in this register to allow this module to generate the corresponding interrupt.</description>
          <addressOffset>0x00000200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>SATCB</name>
              <description>Saturation - Channel B (Slots 2 or 3)</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SATCBINT</name>
                  <description>Saturation, as specified by SAT configuration registers, occurred on either slot 2 or 3 (channel B)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONSATCBINT</name>
                  <description>No-Saturation</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SATCA</name>
              <description>Saturation - Channel A (Slots 0 or 1)</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SATCAINT</name>
                  <description>Saturation, as specified by SAT configuration registers, occurred on either slot 0 or 1 (channel A)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONSATCAINT</name>
                  <description>No Saturation</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ZXCB</name>
              <description>Zero Crossing - Channel B (Slots 2 or 3)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ZXCBINT</name>
                  <description>Zero Crossing, as specified by ZX configuration registers, occurred on either slot 2 or 3 (channel B)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONZXCBINT</name>
                  <description>Non Zero Crossing</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ZXCA</name>
              <description>Zero Crossing - Channel A (Slots 0 or 1)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ZXCAINT</name>
                  <description>Zero Crossing, as specified by ZX configuration registers, occurred on either slot 0 or 1 (channel A)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NONZXCAINT</name>
                  <description>Non Zero Crossing</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DERR</name>
              <description>DMA Error Condition</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DMAERROR</name>
                  <description>DMA Error Condition Occurred</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NODMAERROR</name>
                  <description>DMA Error Condition did not Occurred</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DCMP</name>
              <description>DMA Transfer Complete</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DMACOMPLETE</name>
                  <description>DMA Completed a transfer</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DMAON</name>
                  <description>DMA completion is pending or not triggered.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WCINC</name>
              <description>Window comparator voltage incursion interrupt.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WCINCINT</name>
                  <description>Window comparator voltage incursion interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WCINCNOINT</name>
                  <description>Not a Window comparator voltage incursion interrupt.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WCEXC</name>
              <description>Window comparator voltage excursion interrupt.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WCEXCINT</name>
                  <description>Window comparator voltage excursion interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WCEXCNOINT</name>
                  <description>Not a Window comparator voltage excursion interrupt.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIFOOVR2</name>
              <description>FIFO 100 percent full interrupt.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FIFOFULLINT</name>
                  <description>FIFO 100 percent full interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFOFULLNOINT</name>
                  <description>Not a FIFO 100 percent full interrupt.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIFOOVR1</name>
              <description>FIFO 75 percent full interrupt.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FIFO75INT</name>
                  <description>FIFO 75 percent full interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFO75NOINT</name>
                  <description>Not FIFO 75 percent full interrupt.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SCNCMP</name>
              <description>ADC scan complete interrupt.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
