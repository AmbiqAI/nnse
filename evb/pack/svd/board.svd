            </field>
          </fields>
        </register>
        <register>
          <name>CFG3</name>
          <description>Provides Test fields to put the USB Controller into one of four test modes described in the USB 2.0 specification.  Only one of the Test fields should be set at any time. (Not used in normal operation.) Also includes an index field that determines which endpoint control,status registers are accessed via the IDXn register fields, and a Frame field that holds the last received frame number.</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x3F0FFFFF</resetMask>

          <fields>
            <field>
              <name>ForceFS</name>
              <description>Force Full-speed Mode. The CPU sets this bit to force the USB Controller into Full-speed mode when it receives a USB reset.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FS_NOT_FORCED</name>
                  <description>Do not force FS mode upon USB reset.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FS_FORCED</name>
                  <description>Force FS mode upon USB reset.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ForceHS</name>
              <description>Force High-speed Mode. The CPU sets this bit to force the USB Controller into High-speed mode when it receives a USB reset.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HS_NOT_FORCED</name>
                  <description>Do not force HS mode upon USB reset.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HS_FORCED</name>
                  <description>Force HS mode upon USB reset.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TestPacket</name>
              <description>Test Packet Test Mode. The CPU sets this bit to enter the Test_Packet test mode. In this mode, the USB Controller - in high-speed mode - repetitively transmits on the bus a 53-byte test packet. Note: The 53-byte test packet must be loaded into the Endpoint 0 FIFO before the test mode is entered.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_TPTM</name>
                  <description>Terminates Test Packet Test Mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_TPTM</name>
                  <description>Initiates Test Packet Test Mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TestK</name>
              <description>Test_K Test Mode. The CPU sets this bit to enter the Test_K test mode. In this mode, the USB Controller - in high-speed mode - transmits a continuous K on the bus.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_TESTK</name>
                  <description>Terminates Test_K Test Mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_TESTK</name>
                  <description>Initiates Test_K Test Mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TestJ</name>
              <description>Test_J Test Mode. The CPU sets this bit to enter the Test_J test mode. In this mode, the USB Controller - in high-speed mode - transmits a continuous J on the bus.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_TESTJ</name>
                  <description>Terminates Test_J Test Mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_TESTJ</name>
                  <description>Initiates Test_J Test Mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TestSE0NAK</name>
              <description>Test_SE0_NAK Test Mode. The CPU sets this bit to enter the Test_SE0_NAK test mode. In this mode, the USB Controller remains in high-speed mode and responds to any valid IN token with a NAK.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_TESTSE0NAK</name>
                  <description>Terminates Test_SE0_NAK Test Mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_TESTSE0NAK</name>
                  <description>Initiates Test_SE0_NAK Test Mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENDPOINT</name>
              <description>Index selected endpoint.</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ENDPOINT0</name>
                  <description>Endpoint 0 selected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENDPOINT1</name>
                  <description>Endpoint 1 selected.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENDPOINT2</name>
                  <description>Endpoint 2 selected.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENDPOINT3</name>
                  <description>Endpoint 3 selected.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENDPOINT4</name>
                  <description>Endpoint 4 selected.</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENDPOINT5</name>
                  <description>Endpoint 5 selected.</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FRMNUM</name>
              <description>Frame Number. Read-only field containing the last received frame number in bits 10:0, 15:11 read 0.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>IDX0</name>
          <description>Provides additional control and status for IN transactions through the currently-selected endpoint. (To avoid CMSIS conflicts, the address here includes an additional offset of 0x1000. Access to this register must take this into account.) The value returned when this register is read reflects the status of an endpoint specified by setting the endpoint index in the CFG3_ENDPOINT field. When the endpoint index (CFG3_ENDPOINT) == 0, this field provides status and control of Endpoint 0. Also, the MAXPAYLOAD field defines the maximum amount of data that can be transferred through the selected IN endpoint in a single operation. There is a MAXPAYLOAD for each IN endpoint (except Endpoint 0). Note that the action initiated by setting a field in one of the IDXn registers when the selected endpoint has not been configured is undefined.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>AutoSet</name>
              <description>Automatically Set InPktRdy. When set, the FIFONotEmptyInPktRdy field (for IN Endpoint 0) or InPktRdyOutPktRdy field (for IN Endpoint 1-5) in this register will be automatically set when data of the maximum packet size (set in MAXPAYLOAD field) is loaded into the IN FIFO.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_AUTOSET</name>
                  <description>InPktRdy field is not automatically set when MAXPAYLOAD data size is loaded into the IN FIFO.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTOSET</name>
                  <description>Applicable InPktRdy field is automatically set when MAXPAYLOAD data size is loaded into the IN FIFO. If a packet of less than the maximum packet size is loaded, InPktRdy will have to be set manually. Note: Should not be set for high-bandwidth Isochronous endpoints.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ISO</name>
              <description>Isochronous Transfers. The CPU sets this bit to enable the IN endpoint for Isochronous transfers (ISO mode) or for Bulk/Interrupt transfers.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BULK_INT</name>
                  <description>Clear to enable the IN endpoint for Bulk/Interrupt transfers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ISO</name>
                  <description>Set to enable the IN endpoint for Isochronous transfers.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Mode</name>
              <description>OUT/IN Mode. The CPU sets this bit to enable the endpoint direction as IN or OUT. Note: Only valid where the endpoint FIFO is used for both IN and OUT transactions, otherwise ignored.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OUT</name>
                  <description>Clear to enable the OUT direction for endpoint.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IN</name>
                  <description>Set to enable the IN direction for endpoint.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMAReqEnab</name>
              <description>The CPU sets this bit to enable the DMA request for the IN endpoint.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FrcDataTog</name>
              <description>Force Data Toggle. The CPU sets this bit to force the endpoint's IN data toggle to switch after each data packet is sent regardless of whether an ACK was received. This can be used by Interrupt IN endpoints that are used to communicate rate feedback for Isochronous endpoints.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_FORCE_TOGGLE</name>
                  <description>Keep cleared to not force data toggle.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_TOGGLE</name>
                  <description>Set to force the endpoint's IN data toggle to switch after each data packet is sent.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMAReqMode</name>
              <description>The CPU sets this bit to select DMA Request Mode 1 and clears it to select DMA Request Mode 0. Note: This bit must not be cleared either before or in the same cycle as the above DMAReqEnab bit is cleared.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPktBufDis</name>
              <description>Double Packet Buffer Disable. This bit is used to control the use of Double Packet Buffering. It is ignored when Dynamic FIFO sizing is enabled. Clearing this bit does NOT necessarily enable Double Packet Buffering but rather allows Double Packet Buffering to be determined by the Endpoint's IDX2_INFIFOSZ setting and MAXPAYLOAD size relationship. Default is enabled.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN_DPB</name>
                  <description>Clear to allow Double Packet Buffering.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS_DPB</name>
                  <description>Set to disable Double Packet Buffering regardless of the End Point FIFO size and MAXPAYLOAD size relationship.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>D0</name>
              <description>Unused, always return 0.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IncompTxServiceSetupEnd</name>
              <description>Incomplete Transmission / Service Setup End. When CFG3_ENDPOINT is 1 to 5, this bit serves as the IncompTx field. When CFG3_ENDPOINT is 0, this bit serves as the ServiceSetupEnd field.If CFG3_ENDPOINT is 0x1-0x5, then this bit serves as the IncompTx field. If the endpoint is being used for high-bandwidth Isochronous transfers, this bit is set to indicate when a large packet has been split into 2 or 3 packets for transmission but insufficient IN tokens have been received to send all the parts. The remainder of the current packet is then flushed from the FIFO (but any second packet in the FIFO will remain). Note: In anything other than a high bandwidth Isochronous transfer, this bit will always return 0.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOP</name>
                  <description>This value is a NOP.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLR_SETUPEND</name>
                  <description>Set to clear the SetupEnd bit. This bit is cleared automatically.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ClrDataTogServicedOutPktRdy</name>
              <description>Clear Data Toggle / Serviced OUT Packet Ready. When CFG3_ENDPOINT is 1 to 5, this bit serves as the ClrDataTog field. When CFG3_ENDPOINT is 0, this bit serves as the ServicedOutPktReady field.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the ClrDataTog field. Setting this bit resets the endpoint IN data toggle to 0.If CFG3_ENDPOINT is 0x0, this bit serves as the ServicedOutPktReady field. The CPU writes a 1 to this bit to clear the OutPktRdy bit. This bit is cleared automatically.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SentStallSendStall</name>
              <description>Sent Stall / Send Stall. When CFG3_ENDPOINT is 1 to 5, this bit serves as the SentStall field. When CFG3_ENDPOINT is 0, this bit serves as the SendStall function.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the SentStall field. It is set when a STALL handshake is transmitted. The FIFO is flushed and the InPktRdy bit is cleared. The CPU should clear this bit.If CFG3_ENDPOINT is 0x0, this bit serves as the SendStall field. The CPU sets this bit to terminate the current transaction. The STALL handshake will be transmitted and then this bit will be cleared automatically. Note: This behavior differs from that of the SendStall bits associated with additional IN/OUT endpoints, which need to be cleared by the CPU.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SendStallSetupEnd</name>
              <description>When CFG3_ENDPOINT is 1 to 5, this bit serves as the SendStall field. When CFG3_ENDPOINT is 0, this bit serves as the SetupEnd field.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the SendStall field. Setting this bit issues a STALL handshake to an IN token. The CPU clears this bit to terminate the stall condition.Note: This bit has no effect when the endpoint is being used for Isochronous transfers.If CFG3_ENDPOINT is 0x0, this bit serves as the SetupEnd field. It is set when a control transaction ends before the DataEnd bit has been set. An interrupt will be generated and the FIFO flushed at this time. The bit is cleared by the CPU writing a 1 to the ServicedSetupEnd bit.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FlushFIFODataEnd</name>
              <description>When CFG3_ENDPOINT is 1 to 5, this bit serves as the FlushFIFO field. When CFG3_ENDPOINT is 0, this bit serves as the DataEnd bit.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the FlushFIFO field. Setting this bit flushes the next packet to be transmitted from the endpoint IN FIFO. The FIFO pointer is reset and the InPktRdy bit is cleared. May be set simultaneously with InPktRdy to abort the packet that has just been loaded into the FIFO.Note 1: FlushFIFO should only be set when InPktRdy is set (at other times, it may cause data corruption).Note 2: If the FIFO contains two packets, FlushFIFO may need to be set twice to completely clear the FIFO.If CFG3_ENDPOINT is 0x0, this bit serves as the DataEnd bit. Set this bit when (1) setting InPktRdy for the last data packet, (2) clearing OutPktRdy after unloading the last data packet, or (3) setting InPktRdy for a zero length data packet.It is cleared automatically.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>UnderRunSentStall</name>
              <description>Under Run / Sent Stall. When CFG3_ENDPOINT is 1 to 5, this bit serves as the UnderRun field. When CFG3_ENDPOINT is 0, this bit serves as the SentStall field.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the UnderRun field. In ISO mode this bit is set when a zero length data packet is sent after receiving an IN token with the InPktRdy bit not set. In Bulk/Interrupt mode, this bit is set when a NAK is returned in response to an IN token. The CPU should clear this bit.If CFG3_ENDPOINT is 0x0, this bit serves as the SentStall field. This bit is set when a STALL handshake is transmitted. The CPU should clear this bit.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFONotEmptyInPktRdy</name>
              <description>FIFO Not Empty / IN Packet Ready. When CFG3_ENDPOINT is 1 to 5, this bit serves as the FIFONotEmpty field. When CFG3_ENDPOINT is 0, this bit serves as the InPktRdy bit.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the FIFONotEmpty field. It is set when there is at least 1 packet in the IN FIFO.If CFG3_ENDPOINT is 0x0, this bit serves as the InPktRdy bit. Set this bit after loading a data packet into the FIFO. It is cleared automatically when the data packet has been transmitted. An interrupt is generated when this bit is cleared (if enabled).</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>InPktRdyOutPktRdy</name>
              <description>IN Packet Ready / OUT Packet Ready. When CFG3_ENDPOINT > 0, this bit serves as the InPktRdy field. When CFG3_ENDPOINT is 0, this bit serves as the OutPkyRdy bit.If CFG3_ENDPOINT is 0x1-0x5, this bit serves as the InPktRdy field. Set this bit after loading a data packet into the FIFO. It is cleared automatically when a data packet has been transmitted. If the FIFO is double-buffered, it is also automatically cleared when there is space for a second packet in the FIFO. An interrupt is generate (if enabled) when the bit is cleared.If CFG3_ENDPOINT is 0x0, this bit serves as the OutPkyRdy bit. This bit is set when a data packet has been received. An interrupt is generate when this bit is set (if enabled). The CPU clears this bit by setting the ServicedOutPktRdy bit.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PKTSPLITOPTION</name>
              <description>Packet Split Option. When IDX0_ISO is 1, this bit serves as the MAXPAYLOAD multiplier for Isochronous IN transfers. When IDX0_ISO is 0, this bit serves as the MAXPAYLOAD multiplier for Bulk IN transfers.If IDX0_ISO is 0x1, this field sets the multiplier for Isochronous transfers. For Isochronous endpoints operating in High-Speed mode and with the High-bandwidth option enabled, PKTSPLITOPTION may be either 2 or 3 (corresponding to this field's bit 0 set or bit 1 set, respectively, and bits[4:2] are ignored) and it specifies the maximum number of such transactions that can take place in a single microframe. If either bit 0 or bit 1 is non-zero, the USB Controller will automatically split any data packet written to the FIFO into up to 2 or 3 'USB' packets, each containing the specified MAXPAYLOAD (or less). The maximum payload for each transaction is 1024 bytes, so this allows up to 3072 bytes to be transmitted in each microframe. (For Isochronous transfers in full-speed mode or if High-bandwidth is not enabled, bits 0 and 1 are ignored.)If IDX0_ISO is 0x0, this field sets the multiplier for Bulk transfers. The field setting can be up to 31, and the multiplier, m, is (field setting + 1).  The multiplier defines the maximum number of 'USB' packets of the specified MAXPAYLOAD data bytes into which a single data packet placed in the FIFO should be split prior to transfer. The data packet is required to be an exact multiple of the MAXPAYLOAD, which is itself required to be either 8, 16, 32, 64 or (in the case of High Speed transfers) 512 bytes.</description>
              <bitRange>[15:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MAXPAYLOAD</name>
              <description>Maximum Payload transmitted in a single transaction. The total amount of data represented by MAXPAYLOAD x (PKTSPLITOPTION + 1) must not exceed the FIFO size for the IN endpoint, and should not exceed half the FIFO size if double-buffering is required. Note: The value written here (multiplied by PKTSPLITOPTION + 1 in the case of high-bandwidth Isochronous transfers) must match the value given in the wMaxPacketSize field of the Standard Endpoint Descriptor for the associated endpoint (see USB Specification Revision 2.0, Chapter 9). A mismatch could cause unexpected results.</description>
              <bitRange>[10:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>IDX1</name>
          <description>Provides control and status bits for OUT transactions through the currently-selected endpoint. It is reset to 0. The value returned when this register is read reflects the status of an endpoint specified by setting the endpoint index in the CFG3_ENDPOINT field. Also, the MAXPAYLOAD field defines the maximum amount of data that can be transferred through the selected OUT endpoint in a single operation. There is a MAXPAYLOAD for each OUT endpoint (except Endpoint 0). Note that the action initiated by setting a field in one of the IDXn registers when the selected endpoint has not been configured is undefined.</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFBFFFFFF</resetMask>

          <fields>
            <field>
              <name>AutoClear</name>
              <description>Automatically Clear OutPktRdy.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_AUTOCLR</name>
                  <description>OutPktRdy field will not be automatically cleared when a packet of MAXPAYLOAD data size is unloaded from the OUT FIFO.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTOCLR</name>
                  <description>OutPktRdy field will be automatically cleared when a packet of MAXPAYLOAD data size is unloaded from the OUT FIFO. When packets of less than the maximum packet size are unloaded, OutPktRdy must be cleared manually. Note: Should not be set for high bandwidth Isochronous endpoints.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ISO</name>
              <description>Isochronous Transfers. The CPU sets this bit to enable the OUT endpoint for either Isochronous transfers (ISO mode) or for Bulk/Interrupt transfers.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BULK_INT</name>
                  <description>Clear to enable the OUT endpoint for Bulk/Interrupt transfers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ISO</name>
                  <description>Set to enable the OUT endpoint for Isochronous transfers.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMAReqEnab</name>
              <description>Set this bit to enable the DMA request for the OUT endpoint.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DisNye</name>
              <description>Disable NYET Handshakes / PID Error. For Bulk/Interrupt transactions, this bit disable the sending of NYET handshakes. For Bulk/Interrupt transactions, indicates PID errors.If IDX1_ISO is 0x1, this field is read-only and, when set, indicates a PID error in the received packet for Isochronous transfers.If IDX1_ISO is 0x0, this field disables NYET Handshakes for Bulk/Interrupt transactions. Set this bit to disable the sending of NYET handshakes. When set, all successfully received OUT packets are ACK'd including at the point at which the FIFO becomes full.Note: This bit has an effect only in High-speed mode, when it should be set for all Interrupt endpoints.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DMAReqMode</name>
              <description>Two modes of DMA Request operation are supported: Set to 0 for DMA Request Mode 0 in which a DMA request is generated for all received packets; set to 1 for DMA Request Mode 1 in which a DMA request (but no interrupt) is generated for OUT packets of size MAXPAYLOAD bytes and an interrupt (but no DMA request) is generated for OUT packets of any other size.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPktBufDis</name>
              <description>Double Packet Buffer Disable. This bit is used to control the use of Double Packet Buffering. It is ignored when Dynamic FIFO sizing is enabled. Clearing this bit does NOT necessarily enable Double Packet Buffering but rather allows Double Packet Buffering to be determined by the Endpoint's IDX2_OUTFIFOSZ setting and MAXPAYLOAD size relationship. Default is enabled.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN_DPB</name>
                  <description>Clear to allow Double Packet Buffering.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS_DPB</name>
                  <description>Set to disable Double Packet Buffering regardless of the End Point FIFO size and MAXPAYLOAD size relationship.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IncompRx</name>
              <description>Incomplete Receive. This bit is set in a high-bandwidth Isochronous transfer if the packet in the OUT FIFO is incomplete because parts of the data were not received. It is cleared when OutPktRdy is cleared. Note: In anything other than a high-bandwidth Isochronous transfer, this bit will always return 0.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ClrDataTog</name>
              <description>Clear Data Toggle. Set this bit to reset the endpoint data toggle to 0.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SentStall</name>
              <description>Sent Stall. This bit is set when a STALL handshake is transmitted. The CPU should clear this bit.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SendStall</name>
              <description>Send Stall. Issues a STALL handshake to a DATA packet.If IDX1_ISO is 0x1, this bit has no effect when the endpoint is being used for Isochronous transfers.If IDX1_ISO is 0x0, this field enables Stall Handshakes for Bulk/Interrupt transactions. Set this bit to issue a STALL handshake to a DATA packet. Clear this bit to terminate the stall condition.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FlushFIFO</name>
              <description>Flush FIFO. Set this bit to flush the next packet to be read from the endpoint OUT FIFO. The FIFO pointer is reset and the OutPktRdy bit is cleared. FlushFIFO should only be used when OutPktRdy is set. At other times, it may cause data to be corrupted. If the FIFO is double-buffered, FlushFIFO may need to be set twice to completely clear the FIFO.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DataError</name>
              <description>Data Error. Indicates a CRC error.If IDX1_ISO is 0x1 (ISO mode), this bit is set at the same time that OutPktRdy is set if the data packet has a CRC error. It is cleared when OutPktRdy is cleared.If IDX1_ISO is 0x0 (Bulk mode), this field always returns zero. This field is only valid when the endpoint is operating in ISO mode.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OverRun</name>
              <description>Overrun Condition. Indicates an overrun.If IDX1_ISO is 0x1 (ISO mode), this bit is set if an OUT packet arrives while FIFOFull is set, i.e., the OUT packet cannot be loaded into the OUT FIFO. The CPU should clear this bit.If IDX1_ISO is 0x0 (Bulk mode), this field always returns zero. This field is only valid when the endpoint is operating in ISO mode.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIFOFull</name>
              <description>FIFO Full. When set, this bit indicates that no more packets can be loaded into the OUT FIFO.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OutPktRdy</name>
              <description>OUT Packet Ready. This bit is set when a data packet has been received. Clear this bit when the packet has been unloaded from the OUT FIFO. An interrupt is generated (if enabled) when the bit is set.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PKTSPLITOPTION</name>
              <description>Packet Split Option. When IDX1_ISO is 1, this bit serves as the MAXPAYLOAD multiplier for Isochronous OUT transfers. When IDX1_ISO is 0, this bit serves as the MAXPAYLOAD multiplier for Bulk IN transfers.If IDX1_ISO is 0x1, this field sets the multiplier for Isochronous transfers. For Isochronous endpoints operating in High-Speed mode and with the High-bandwidth option enabled, PKTSPLITOPTION may be either 2 or 3 (corresponding to this field's bit 0 set or bit 1 set, respectively, and bits[4:2] are ignored) and it specifies the maximum number of such transactions that can take place in a single microframe. If either bit 0 or bit 1 is non-zero, the USB Controller will automatically combine the separate USB packets received in any microframe into a single packet within the OUT FIFO. The maximum payload for each transaction is 1024 bytes, so this allows up to 3072 bytes to be received in each microframe. (For Isochronous transfers in full-speed mode or if high-bandwidth is not enabled, bits 0 and 1 are ignored.)If IDX1_ISO is 0x0, this field sets the multiplier for Bulk transfers. The field setting can be up to 31, and the multiplier, m, is (field setting + 1).  The multiplier defines the number of USB packets of the specified payload which are to be combined into a single data packet within the FIFO.</description>
              <bitRange>[15:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MAXPAYLOAD</name>
              <description>Maximum Payload transmitted in a single transaction. The value set can be up to 1024 bytes but is subject to the constraints placed by the USB Specification on packet sizes for Bulk, Interrupt and Isochronous transfers in Fullspeed and High-speed operations. The total amount of data represented by MAXPAYLOAD x (PKTSPLITOPTION + 1) must not exceed the FIFO size for the OUT endpoint, and should not exceed half the FIFO size if double-buffering is required. Note: The value written here (multiplied by m in the case of high-bandwidth Isochronous transfers) must match the value given in the wMaxPacketSize field of the Standard Endpoint Descriptor for the associated endpoint (see USB Specification Revision 2.0, Chapter 9). A mismatch could cause nexpected results.</description>
              <bitRange>[10:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>IDX2</name>
          <description>Contains the outcount value for number of received bytes in the packet in the OUT FIFO, and the configurable IN and OUT Endpoint FIFO size.</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1F1F1FFF</resetMask>

          <fields>
            <field>
              <name>OUTFIFOSZ</name>
              <description>OUT FIFO Size. Sets the size of the selected OUT endpoint FIFO. Bit 4 of this field defines whether double-packet buffering is supported. When set, double-packet buffering is supported. When cleared, only single-packet buffering is supported. Bits [3:0] of this field determine maximum packet size, where 2^^(b3:b0 + 3) is the maximum packet size to be allowed (before any splitting within the FIFO of Bulk/High-Bandwidth packets prior to transmission).</description>
              <bitRange>[28:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INFIFOSZ</name>
              <description>IN FIFO Size. Sets the size of the selected IN endpoint FIFO. Bit 4 of this field defines whether double-packet buffering supported. When set, double-packet buffering is supported. When cleared, only single-packet buffering is supported. Bits [3:0] of this field determine maximum packet size, where 2^^(b3:b0 + 3) is the maximum packet size to be allowed (before any splitting within the FIFO of Bulk/High-Bandwidth packets prior to transmission).</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ENDPTOUTCOUNT</name>
              <description>Endpoint OUT Count. When CFG3_ENDPOINT is 1 to 5, this read-only field holds the number of received data bytes in the packet in the Endpoint's OUT FIFO. When CFG3_ENDPOINT is 0, this read-only field holds 7-bit data for number of received data bytes in Endpoint 0 FIFO (OUT count). In either case, the value returned changes as the contents of the FIFO change and is only valid while OutPktRdy is set. (IMPORTANT: The address for the OUTCOUNT register is actually the same as COUNT0. However to avoid CMSIS conflicts, the address here includes an additional offset of 0x1000. Access to this register must take this into account.)If CFG3_ENDPOINT is 0x1-0x5, this read-only field holds the number of received data bytes in the packet in the OUT FIFO. If the packet was transmitted as multiple bulk packets, the number given will be for the combined packet.If CFG3_ENDPOINT is 0x0, this read-only field holds 7-bit data for number of received data bytes in Endpoint 0 FIFO (OUT count).</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFOADD</name>
          <description>Sets the start address of the selected IN and OUT endpoint FIFOs.</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1FFF1FFF</resetMask>

          <fields>
            <field>
              <name>OUTFIFOADD</name>
              <description>Sets the start address of the selected OUT endpoint FIFO.</description>
              <bitRange>[28:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>INFIFOADD</name>
              <description>Sets the start address of the selected IN endpoint FIFO.</description>
              <bitRange>[12:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO0</name>
          <description>Endpoint 0 FIFO register</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 0.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO1</name>
          <description>Endpoint 1 FIFO register</description>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 1.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO2</name>
          <description>Endpoint 2 FIFO register</description>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 2.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO3</name>
          <description>Endpoint 3 FIFO register</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 3.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO4</name>
          <description>Endpoint 4 FIFO register</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 4.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>FIFO5</name>
          <description>Endpoint 5 FIFO register</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>FIFO</name>
              <description>Writing to this register loads data into the IN FIFO and reading from this register unloads data from the OUT FIFO for endpoint 5.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HWVERS</name>
          <description>Read-only register that returns version number (xx.yyy) of the core hardware.</description>
          <addressOffset>0x0000006C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>RC</name>
              <description>Unused</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>xx</name>
              <description>Major Version Number (Range 0 - 31).</description>
              <bitRange>[14:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>yyy</name>
              <description>Minor Version Number (Range 0 - 999).</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>INFO</name>
          <description>Contains read-only info of the number of IN and OUT endpoints included in the design, width of the RAM, the ability to reset the USB Controller via software, a soft reset bit for the CLK clock domain and a soft reset bit for the XCLK clock domain.</description>
          <addressOffset>0x00000078</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0303FFFF</resetMask>

          <fields>
            <field>
              <name>EDMAIN</name>
              <description>DMA_REQ deassert for all IN endpoints.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEASSERT_MAXPAYLOAD</name>
                  <description>DMA_REQ signal for all IN Endpoints will be de-asserted when MAXPAYLOAD bytes have been written to an endpoint.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEASSERT_MAXPAYLOADMINUS8</name>
                  <description>DMA_REQ signal for all IN Endpoints will be de-asserted when MAXPAYLOAD-8 bytes have been written to an endpoint.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EDMAOUT</name>
              <description>DMA_REQ deassert for all OUT Endpoints.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEASSERT_MAXPAYLOAD</name>
                  <description>DMA_REQ signal for all OUT Endpoints will be de-asserted when MAXPAYLOAD bytes have been read to an endpoint. When 1 byte early.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEASSERT_MAXPAYLOADMINUS8</name>
                  <description>DMA_REQ signal for all OUT Endpoints will be de-asserted when MAXPAYLOAD-8 bytes have been read to an endpoint. When 1 byte early.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTXS</name>
              <description>Soft reset for the XCLK domain. will cause the output signal NRSTXO to be asserted low. This bit is self-clearing. For reset to actually occur, the output NRSTXO must be connected to the input NRSTX.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RSTS</name>
              <description>Soft reset for the CLK domain. cause the output signal NRSTO to be asserted low. This bit is self-clearing. For reset to actually occur, the output NRSTO must be connected to the input NRST.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DMAChains</name>
              <description>Provides the number of implemented DMA channels.</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RamBits</name>
              <description>Provides the width of the RAM address bus.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OutEndPoints</name>
              <description>Provides the number of implemented OUT Endpoints.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>InEndPoints</name>
              <description>Provides the number of implemented IN Endpoints.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT1</name>
          <description>Holds the configurable chirp timeout value.</description>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00004074</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>CTUCH</name>
              <description>Configurable Chirp Timeout timer; default value of 0x4074 corresponds to a delay of 1.1ms (60Mhz clock cycles * 4 * 0x4074).</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT2</name>
          <description>Holds the configurable delay from the end of High Speed resume signal to enable UTM normal operating mode.</description>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000032</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>CTHRSTN</name>
              <description>Configurable delay from the end of High Speed resume signaling to enabling UTM normal operating mode. Default value of 0x32 corresponds to a delay of 3us. This programmed delay is equivalent to the number of 60MHz clock cycles * 4.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>CLKCTRL</name>
          <description>Provides optional control for turning off the interface clocks to USB Controller and PHY as well as the reference clock to the USB PHY.</description>
          <addressOffset>0x00002000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x07010101</resetMask>

          <fields>
            <field>
              <name>PHYREFCLKSEL</name>
              <description>USB PHY reference clock select. The reference clock frequency needs to be 24MHz.</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HFRC_48MHz</name>
                  <description>48MHz HFRC. Internally will divide by 2 before using it as USB PHY reference clock.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC2_31MHz</name>
                  <description>31MHz HFRC2. Internally will divide by 2 before using it as USB PHY reference clock. This is only for engineering purpose, as it does not meet the 24MHz frequency requirement.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC_24MHz</name>
                  <description>24MHz HFRC based reference clock</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTREFCLK</name>
                  <description>External reference clock</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTREFCLK_DIV2</name>
                  <description>External reference clock divide by 2</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XTALHS</name>
                  <description>XTAL clock as reference clock</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XTALHS_DIV2</name>
                  <description>XTAL clock divide by 2 as reference clock</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Static 0</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PHYAPBLCLKDIS</name>
              <description>Setting this bit turns off PHY control logic clock.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CTRLAPBCLKDIS</name>
              <description>Setting this bit turns off the Controller logic clock.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PHYREFCLKDIS</name>
              <description>Setting this bit turns off the PHY reference clock.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SRAMCTRL</name>
          <description>Provides optional SRAM tuning control.</description>
          <addressOffset>0x00002004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000007F</resetValue>
          <resetMask>0x00007FFF</resetMask>

          <fields>
            <field>
              <name>STOV</name>
              <description>SRAM self-timed override</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>WABL</name>
              <description>SRAM write assist enable</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>WABLM</name>
              <description>SRAM No margin adjustment</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RAWL</name>
              <description>SRAM Read assist enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RAWLM</name>
              <description>SRAM Adjustment for margin for this read assist scheme</description>
              <bitRange>[8:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INCDLY</name>
                  <description>Increased margin adjustment, increased delay for enabling write assist.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MBINCDLY</name>
                  <description>Minimum boost level with increased delay for enabling write assist.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IMNB</name>
                  <description>Increased margin adjustment with more negative boost.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MMNB</name>
                  <description>Minimum margin adjustment with lowest negative boost level.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMAW</name>
              <description>Extra margin adjustment for write operations</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EMAS</name>
              <description>Extra margin adjustment sense amplifier pulse</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>EMA</name>
              <description>Extra margin adjustment</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RET1N</name>
              <description>Retention mode 1 enable, active-LOW</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>UTMISTICKYSTATUS</name>
          <description>This read only register provides the results from the PHY OBS port controlled by reg 0x20[5:4]. IF any bits are set, the bits are sticky. Clear this register using the OBSCLRSTAT register.</description>
          <addressOffset>0x00002014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>OBSPORTSTICKY</name>
              <description>These bits are read only status bits from the PHY OBS port</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OBS3</name>
                  <description>bit 1:HS BIST results, bit 0:FS BIST results</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OBS2</name>
                  <description>bit 1: ODT calibration state, bit 0: Current calibration state</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OBS1</name>
                  <description>bit 1: Rx squelch signal, bit 0: Rx datap</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OBS0</name>
                  <description>bit 1: PLL lock signal, bit 0: Host Disconnect</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>OBSCLRSTAT</name>
          <description>Clears all bits in the sticky obs status register.</description>
          <addressOffset>0x00002018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>CLRSTAT</name>
              <description>Writing a 1 to this bit clears all bits in the UTMISTICKYSTATUS register.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>DPDMPULLDOWN</name>
          <description>Enables a pulldown resistor(15K) on D+ or D-</description>
          <addressOffset>0x0000201C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>DPPULLDOWN</name>
              <description>Enables a pulldown resistor(15K) on D+</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DMPULLDOWN</name>
              <description>Enables a pulldown resistor(15K) on D-</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>BCDETSTATUS</name>
          <description>USB Battery Charge Detenction Registers</description>
          <addressOffset>0x00002020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000037</resetMask>

          <fields>
            <field>
              <name>DMCOMPOUT</name>
              <description>DM comparator output</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPCOMPOUT</name>
              <description>DP comparator output</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DCPDETECTED</name>
              <description>Dedicated charging port detected</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CPDETECTED</name>
              <description>Charging port detected</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DPATTACHED</name>
              <description>Data pin attachment detected</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>BCDETCRTL1</name>
          <description>Battery Charging detection main control register</description>
          <addressOffset>0x00002024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0x80000BFF</resetMask>

          <fields>
            <field>
              <name>USBSWRESET</name>
              <description>Holds a USB controller and PHY in the reset for BC detection</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>USBDCOMPEN</name>
              <description>Enables DP/DM vendor-specific detection comparator</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>USBDCOMPREF</name>
              <description>Sets DP/DM vendor-specific comparator ref voltage</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1P25V</name>
                  <description>1.25V</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2P35</name>
                  <description>2.35V</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3P10V</name>
                  <description>3.10V</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1P65</name>
                  <description>1.65V (VCCIO/2)</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDPSINKEN</name>
              <description>Enables DP current sink</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VDMSRCEN</name>
              <description>Enables DM voltage source</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
