              <access>read-write</access>

            </field>
            <field>
              <name>RSVD11</name>
              <description>This field is reserved.</description>
              <bitRange>[26:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DATA2DBI</name>
