                <enumeratedValue>
                  <name>NOTSUPPORTED</name>
                  <description>Does not support 64 bit system address</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VOLT18V</name>
              <description>Voltage support 1.8v</description>
