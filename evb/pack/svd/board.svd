                  <description>Two channels in phase 1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3CHLS</name>
                  <description>Three channels in phase 1.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4CHLS</name>
                  <description>Four channels in phase 1.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5CHLS</name>
                  <description>Five channels in phase 1.</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6CHLS</name>
                  <description>Six channels in phase 1.</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7CHLS</name>
                  <description>Seven channels in phase 1.</description>
