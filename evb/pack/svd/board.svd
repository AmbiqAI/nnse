                  <description>MONO Left</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MONOR</name>
                  <description>MONO right</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STEREO</name>
                  <description>Stereo</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CORECTRL</name>
          <description>PDM to PCM Control</description>
          <addressOffset>0x0000000C</addressOffset>
