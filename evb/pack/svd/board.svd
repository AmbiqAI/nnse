        <register>
          <name>MISC</name>
          <description>This register controls a 'safe' mode for burst, which disables the clock when burst transition is happening. It also includes a register to force the HFRC during deep sleep. It is mainly used for debug and testing.</description>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x08000000</resetValue>
          <resetMask>0x03FBFFE3</resetMask>

          <fields>
            <field>
              <name>CLKGENMISCSPARE</name>
