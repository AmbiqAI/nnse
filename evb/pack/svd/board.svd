                <enumeratedValue>
                  <name>TMR31</name>
                  <description>Trigger source is TIMER 3 Output 1</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR40</name>
                  <description>Trigger source is TIMER 4 Output 0</description>
                  <value>8</value>
