                </enumeratedValue>
                <enumeratedValue>
                  <name>LANE1</name>
                  <description>lane 1 polarity swap</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LANE2</name>
                  <description>lane 2 polarity swap</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
