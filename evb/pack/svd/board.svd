                  <description>Clock source is TIMER 15 Output 1</description>
                  <value>63</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIO0</name>
                  <description>GPIO #0 is clock source.</description>
                  <value>256</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOn</name>
                  <description>GPIO #n is clock source where n ranges from 0-223. The values for GPIO0 - GPIO223 are in the range 0x100 - 0x1DF, i.e. GPIO0 + n.</description>
                  <value>257</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIO223</name>
                  <description>GPIO #223 is clock source.</description>
                  <value>479</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR2FN</name>
              <description>Counter/Timer 2 Function Select. For all Functions, CMP0 marks the end of timer cycle, and thus restarts the timer.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EDGE</name>
                  <description>This Mode generates a single edge on OUT0/OUT1 when TIMER value hits CMP0/CMP1 respectively. OUT[0]=0, counter increments to CMP0, OUT[0]=1, counter stops. OUT[1] follows CMP1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UPCOUNT</name>
                  <description>This mode is run up counter generating a pulse on CMP. OUT[0]/OUT[1] is pulsed for one source clock period when TIMER matches CMP0/CMP1 respectively. Timer repeats for TMR_LMT iterations.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM</name>
                  <description>PWM mode. OUT0 and OUT1 are waveforms, and not just one clock pulse. CMP1 dictates the low phase of the output and CMP0 dictates the period. OUT[1]=~OUT[0].</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SINGLEPATTERN</name>
                  <description>Single pattern. OUT0=CMP0[TIMER], OUT1=CMP1[TIMER]. LMT field specifies length of pattern. When LMT GT 32 OUT0 and OUT1 is the same 64-bit pattern consisting of concatenated CMP1,CMP0. When LMT LT 32 OUT0 and OUT1 are independent. Both OUT0 and OUT1 can be inverted individually applications with POL0/POL1 = 0x1.</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REPEATPATTERN</name>
                  <description>Repeated pattern. Like SINGLEPATTERN mode, but pattern repeats after reaching LMT.</description>
                  <value>13</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR2POL1</name>
              <description>Counter/Timer 2 output 1 polarity.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>The polarity of the TMR2OUT1 pin is the same as the timer output.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INVERTED</name>
                  <description>The polarity of the TMR2OUT1 pin is the inverse of the timer output.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR2POL0</name>
              <description>Counter/Timer 2 output 0 polarity.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>The polarity of the TMR2OUT0 pin is the same as the timer output.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INVERTED</name>
                  <description>The polarity of the TMR2OUT0 pin is the inverse of the timer output.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR2CLR</name>
              <description>Counter/Timer Clear bit.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>When written to a 1, the timer will automatically be cleared to its reset state # (0 for count up counter, CMP0 for down counter)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <description>Default value set to 0. Timer works normally.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR2EN</name>
              <description>Counter/Timer 2 Enable bit.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Counter/Timer 2 Disable.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Counter/Timer 2 Enable.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMER2</name>
          <description>This register holds the running time or event count for timer 2.</description>
          <addressOffset>0x00000244</addressOffset>
