        <register>
          <name>CHACHACONTROLREG</name>
          <description>CHACHA general configuration.</description>
          <addressOffset>0x00000380</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
