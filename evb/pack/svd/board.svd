                  <description>Out Endpoint interrupt enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EP1OutIntEn</name>
              <description>Out Endpoint 1 Interrupt Enable.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Out Endpoint interrupt disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
