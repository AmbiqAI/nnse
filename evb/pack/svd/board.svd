                <enumeratedValue>
                  <name>TMR41</name>
                  <description>Trigger source is TIMER 4 Output 1</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR50</name>
                  <description>Trigger source is TIMER 5 Output 0</description>
                  <value>10</value>
                </enumeratedValue>
