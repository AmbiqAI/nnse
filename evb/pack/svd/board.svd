          <fields>
            <field>
              <name>TMR9LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 9. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

