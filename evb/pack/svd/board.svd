          <resetMask>0xF800FF0F</resetMask>

          <fields>
            <field>
              <name>DSIBISTDONE</name>
              <description>Status of the BIST engine, indicates the completion as well as error conditions.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTERRRXESC</name>
              <description>Indicates the normal error conditions in LP mode. Also indicates the RxClkEsc mode error.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTERRRXESCSYNC</name>
              <description>Indicates the sync error conditions in LP mode.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTERRRXHS</name>
              <description>Indicates the normal error conditions in HS mode.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTERRRXHSSYNC</name>
              <description>Indicates the sync error conditions in HS mode.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTSEED</name>
              <description>bist_seed in hardware</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTMODE</name>
              <description>{bist_en_esc_lp, bist_en_esc_hs} in hardware.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HSMODE</name>
                  <description>HS mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LPMODE</name>
                  <description>LP mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RXCLKESCMODE</name>
                  <description>RxClkEsc mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DSIBISTFORCEERR</name>
              <description>bist_force_error in hardware</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DSIBISTLP</name>
              <description>To enable the BIST this bit (dln_loop_back in hardware) needs to be set to 1. This signal internally asserts the clock for the BIST modules.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>MMSMISCCTRL</name>
          <description>MM Sytem Miscellaneous Control</description>
          <addressOffset>0x000004A4</addressOffset>
