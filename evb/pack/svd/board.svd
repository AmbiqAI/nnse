              <description>Ignore HCPD</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREHCPC</name>
              <description>Ignore HCPC</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREHCPB</name>
