                <enumeratedValue>
                  <name>16b</name>
                  <description>Receive channel length is 16 bits for phase 1.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20b</name>
                  <description>Receive channel length is 20 bits for phase 1.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24b</name>
                  <description>Receive channel length is 24 bits for phase 1.</description>
                  <value>4</value>
