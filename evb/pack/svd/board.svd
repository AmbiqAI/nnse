          <name>HASHH4</name>
          <description>H4 data. can only be written in the following HASH_CONTROL modes: SHA1 SHA224 SHA256 SHA384 SHA512</description>
          <addressOffset>0x00000650</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HASHH4</name>
              <description>1) Write initial Hash value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHH5</name>
          <description>H5 data. can only be written in the following HASH_CONTROL modes: SHA224 SHA256 SHA384 SHA512</description>
          <addressOffset>0x00000654</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HASHH5</name>
