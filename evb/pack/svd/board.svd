                <enumeratedValue>
                  <name>12b</name>
                  <description>Receive audio sample length is 12 bits for phase 1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16b</name>
                  <description>Receive audio sample length is 16 bits for phase 1.</description>
