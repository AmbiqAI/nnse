        <register>
          <name>HASHH8</name>
          <description>H8 data. can only be written in the following HASH_CONTROL modes: SHA384 SHA512</description>
          <addressOffset>0x00000660</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HASHH8</name>
              <description>1) Write initial Hash value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AUTOHWPADDING</name>
          <description>HW padding automatically activated by engine. For the special case of ZERO bytes data vector this register should not be used! instead use HASH_PAD_CFG</description>
          <addressOffset>0x00000684</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>EN</name>
              <description>0x1 - Enable Automatic HW padding (No need for SW intervention by writing PAD_CFG). Note: Not supported for 0 bytes ! Note: Disable this register when HASH op is done</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHXORDIN</name>
          <description>This register is always xored with the input to the hash engine,it should be 0 if xored is not reqiured .</description>
          <addressOffset>0x00000688</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>HASHXORDATA</name>
              <description>This register holds the value to be xor-ed with hash input data.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>LOADINITSTATE</name>
          <description>Indication to HASH that the following data is to be loaded into initial value registers in HASH(H0:H15) or IV to AES MAC</description>
          <addressOffset>0x00000694</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>LOAD</name>
              <description>Load data to initial state registers. digest_iv for hash_aes_mac. When done loading data this bit should be reset</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHSELAESMAC</name>
          <description>select the AES MAC module rather than the hash module</description>
          <addressOffset>0x000006A4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>GHASHSEL</name>
              <description>GHASH select.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HASH_MOD</name>
                  <description>select the hash module</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GHASH_MOD</name>
                  <description>select the ghash module</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HASHSELAESMAC</name>
              <description>Hash or AES MAC module select.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HASH_MOD</name>
                  <description>select the hash module</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MAC_MOD</name>
                  <description>select the AES mac module</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HASHVERSION</name>
          <description>HASH VERSION Register</description>
          <addressOffset>0x000007B0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>

          <fields>
            <field>
              <name>MAJORVERSIONNUMBER</name>
              <description>major version number</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MINORVERSIONNUMBER</name>
              <description>minor version number</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FIXES</name>
              <description>Fixes field.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHCONTROL</name>
          <description>Selects which HASH mode to run</description>
          <addressOffset>0x000007C0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000B</resetMask>

          <fields>
            <field>
              <name>MODE3</name>
              <description>bit 3 of the HASH mode field. The hash mode field possible values are:4b0000 - MD5 if present 0x0001  SHA 1 4b0010 - SHA-256 4b1010 - SHA-224</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MODE01</name>
              <description>bits 1:0 of the HASH mode field. The hash mode field possible values are:</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MD5</name>
                  <description>MD5 if present</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA_1</name>
                  <description>SHA-1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA_256</name>
                  <description>SHA-256</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HASHPADEN</name>
          <description>Enables the hash hw padding.</description>
          <addressOffset>0x000007C4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>EN</name>
              <description>0x1 : Enable generation of padding by HW Pad block. 0x0 :  Disable generation of padding by HW Pad block.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHPADCFG</name>
          <description>This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x000007C8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000004</resetMask>

          <fields>
            <field>
              <name>DOPAD</name>
              <description>Enable Padding generation. must be reset upon completion of padding.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHCURLEN0</name>
          <description>This register holds the length of current hash operation bit 31:0.</description>
          <addressOffset>0x000007CC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>Length</name>
              <description>Represent the current length of valid bits where digest need to be computed In Bytes.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHCURLEN1</name>
          <description>This register holds the length of current hash operation bit 63:32.</description>
          <addressOffset>0x000007D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>Length</name>
              <description>Represent the current length of valid bits where digest need to be computed In Bytes.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHPARAM</name>
          <description>HASH_PARAM Register.</description>
          <addressOffset>0x000007DC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00012001</resetValue>
          <resetMask>0x0007FFFF</resetMask>

          <fields>
            <field>
              <name>DUMPHASHTODOUTEXISTS</name>
              <description>Indicate if HASH to dout is present in the design</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HASHCOMPAREEXISTS</name>
              <description>Indicate if COMPARE digest logic is present in the design</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SHA256EXISTS</name>
              <description>Indicate if SHA-256 is present in the design</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>HMACEXISTS</name>
              <description>Indicate if HMAC logic is present in the design</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>MD5EXISTS</name>
              <description>Indicate if MD5 is present in HW</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>PADEXISTS</name>
              <description>Indicate if pad block is present in the design. 0 - pad function is not supported by hardware. 1 - pad function is supported by hardware.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>SHA512EXISTS</name>
              <description>Indicate if SHA-512 is present in the design. By default SHA-1 and SHA-256 are present. 0 - SHA-1 and SHA-256 are present only 1 - SHA-1 and all SHA-2 are present (SHA-256 SHA-512).</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DW</name>
              <description>Determine the granularity of word size. 0 - 32 bit word data. 1 - 64 bit word data.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CH</name>
              <description>Indicate if Hi adders are present for each Hi value or 1 adder is shared for all Hi. 0 - One Hi value is updated at a time 1 - All Hi values are updated at the same time.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>CW</name>
              <description>Indicates the number of concurrent words the hash is using to compute signature. 1 - One concurrent w(t). 2 - Two concurrent w(t).</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHAESSWRESET</name>
          <description>Software reset of the AES.</description>
          <addressOffset>0x000007E4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>HASHAESSWRESET</name>
              <description>Hash receive reset internally.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>HASHENDIANESS</name>
          <description>This register holds the HASH_ENDIANESS configuration.</description>
          <addressOffset>0x000007E8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>ENDIAN</name>
              <description>The default value is little-endian. The data and generation of padding can be swapped to be big-endian.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>AESCLKENABLE</name>
          <description>This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00000810</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>EN</name>
              <description>Enable the AES clock.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLK_E</name>
                  <description>the AES clock is enabled.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLK_D</name>
                  <description>the AES clock is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HASHCLKENABLE</name>
          <description>The HASH clock enable register. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00000818</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>EN</name>
              <description>Enable the hash clock.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HASH_E</name>
                  <description>the HASH clock is enabled.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HASH_D</name>
                  <description>the HASH clock is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
