        <register>
          <name>TMR3CMP0</name>
          <description>This contains the Compare limits for timer 3. This is the primary comparator that can be used to mark the END of a timer cycle (and thus restart the timer for repeat modes)</description>
          <addressOffset>0x00000268</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

