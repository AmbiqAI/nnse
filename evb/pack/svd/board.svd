              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HFRC2_31MHz</name>
                  <description>31MHz sourced from the HFRC2</description>
                  <value>0</value>
                </enumeratedValue>
