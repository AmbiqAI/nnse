          <description>This register defines the endianness of the Host-accessible registers. Note: This is a special register, affected by internal logic. Test result of this register is NA.</description>
          <addressOffset>0x00000A0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00008888</resetMask>

          <fields>
            <field>
              <name>DINRDWBG</name>
              <description>DIN write word endianness:</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LE</name>
                  <description>little endian</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BE</name>
                  <description>big endian</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DOUTWRWBG</name>
              <description>DOUT write word endianness:</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LE</name>
                  <description>little endian</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BE</name>
                  <description>big endian</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DINRDBG</name>
              <description>DIN write endianness:</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LE</name>
                  <description>little endian</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BE</name>
                  <description>big endian</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DOUTWRBG</name>
              <description>DOUT write endianness:</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LE</name>
                  <description>little endian</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BE</name>
                  <description>big endian</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
