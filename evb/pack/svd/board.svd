      <registers>
        <register>
          <name>CTRL</name>
          <description>General Timer Controls</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x80000000</resetMask>

          <fields>
            <field>
              <name>RESET</name>
              <description>Write to 1 to reset all timers (self-clearing)</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>General Timer status</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00100000</resetValue>
          <resetMask>0x001FFFFF</resetMask>

          <fields>
            <field>
              <name>NTIMERS</name>
              <description>Indicates the number of timer blocks present in the design</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACTIVE</name>
              <description>Indicates which timers are currnetly active (enabled)</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>GLOBEN</name>
          <description>Alternate enables for all TIMERs.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000FFFF</resetValue>
          <resetMask>0xE000FFFF</resetMask>

          <fields>
            <field>
              <name>ADCEN</name>
              <description>ADC controls enable for timer 7</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Timer Enabled. TMREN enable is used.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable TIMER .</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUDADCEN</name>
