                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5STEP</name>
                  <description>clock duty cycle tuning with amount of 5 steps</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6STEP</name>
                  <description>clock duty cycle tuning with amount of 6 steps</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7STEP</name>
                  <description>clock duty cycle tuning with amount of 7 steps</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8STEP</name>
