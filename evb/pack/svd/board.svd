                </enumeratedValue>
                <enumeratedValue>
                  <name>1CYCLES</name>
                  <description>One xtra PDMCLK cycle delay.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2CYCLES</name>
                  <description>Two extra PDMCLK cycle delays.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3CYCLES</name>
                  <description>Three extra PDMCLK cycle delays.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4CYCLES</name>
                  <description>Four extra PDMCLK cycle delays.</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5CYCLES</name>
                  <description>Five extra PDMCLK cycle delays.</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6CYCLES</name>
                  <description>Six extra PDMCLK cycle delays.</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7CYCLES</name>
                  <description>Seven extra PDMCLK cycle delays.</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIVMCLKQ</name>
              <description>Divide down ratio for generating internal master MCLKQ.
DIVMCLKQ > 0. DIVMCLKQ = 0 PROHIBITED.
Recommend value of 1.
Fmclkq = Fpdmclk/(DIVMCLKQ+1).</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
