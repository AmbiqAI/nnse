        <register>
          <name>CTRL14</name>
          <description>This includes the Control bit fields for timer 14.</description>
          <addressOffset>0x000003C0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF07FFFF</resetMask>

          <fields>
            <field>
              <name>TMR14LMT</name>
              <description>This field decides the number of iterations of Counter/Timer 14. For Single/Repeat Patterns, it indicates number of bits to be shifted out and so, max value is 63.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TMR14TMODE</name>
              <description>Counter/Timer 14 Trigger Mode</description>
              <bitRange>[18:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Trigger not enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RISE</name>
                  <description>Trigger on rising edge of TRIGSEL source</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALL</name>
                  <description>Trigger on falling edge of TRIGSEL source</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOTH</name>
                  <description>Trigger on either edge of TRIGSEL source</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TMR14CLK</name>
              <description>Counter/Timer 14 Clock Select. Note: Any GPIO can be used as a clock source.</description>
              <bitRange>[16:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HFRC_DIV4</name>
                  <description>Clock source is the HFRC / 4</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC_DIV16</name>
                  <description>Clock source is HFRC / 16</description>
                  <value>1</value>
                </enumeratedValue>
