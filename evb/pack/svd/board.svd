                <enumeratedValue>
                  <name>TMR11</name>
                  <description>Trigger source is TIMER 1 Output 1</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR20</name>
                  <description>Trigger source is TIMER 2 Output 0</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR21</name>
