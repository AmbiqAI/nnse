          <name>SIMOBUCK3</name>
          <description>SIMO Buck Muxed VDDC low power Sequence Trim Control</description>
          <addressOffset>0x00000348</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>VDDCLPLOWTONTRIM</name>
