        </register>
        <register>
          <name>WICCONTROL</name>
          <description>This register is responsible for WIC Control and Configuration</description>
          <addressOffset>0x0000021C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>DEEPISWIC</name>
              <description>Indicates SLEEPDEEP is WIC SLEEP or Normal SLEEP</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLEEPDEEP_IS_REGULAR_SLEEP</name>
                  <description>When de-asserted, SCR.SLEEPDEEP is set and the processor core is in sleep, the processor does not enter WIC sleep, and the processor must stay powered-up.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLEEPDEEP_IS_WIC_SLEEP</name>
                  <description>When asserted, SCR.SLEEPDEEP is set and the processor core is in sleep, the processor enters WIC sleep and the clock and power can both be removed from the processor.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGCTRL</name>
          <description>Debug subsystem Control. Determines the debug components enable and clk frequency.</description>
          <addressOffset>0x00000250</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00004105</resetValue>
          <resetMask>0x0000710F</resetMask>

          <fields>
            <field>
              <name>DBGTSCLKSEL</name>
              <description>This field selects the frequency of the ARM M55 dbg ts port.</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOWPWR</name>
                  <description>Low power state.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV2</name>
                  <description>Selects HFRC divided by 2 as the source dbg ts clk</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV8</name>
                  <description>Selects HFRC divided by 8 as the source dbg ts clk</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV16</name>
                  <description>Selects HFRC divided by 16 as the source dbg ts clk</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRCDIV32</name>
                  <description>Selects HFRC divided by 32 as the source dbg ts clk</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGETBENABLE</name>
              <description>Debug subsystem ETB enable to store the trace data.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable ETB.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable ETB.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGTPIUCLKSEL</name>
              <description>This field selects the frequency of the ARM TPIU port.</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Low power state.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC_48MHz</name>
                  <description>Selects HFRC 48Mhz as the source TPIU clk</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC_96MHz</name>
                  <description>Selects HFRC 96Mhz as the source TPIU clk</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC_192MHz</name>
                  <description>Selects HFRC 192Mhz as the source TPIU clk</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC2_125MHz</name>
                  <description>Selects HFRC2 125Mhz as the source TPIU clk. Note that this setting requires CLKGEN.MISC.HFRC2 be enabled</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFRC2_250MHz</name>
                  <description>Selects HFRC2 250Mhz as the source TPIU clk. Note that this setting requires CLKGEN.MISC.HFRC2 be enabled</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGTPIUTRACEENABLE</name>
              <description>TPIU TRACE Enable field. When set, the Apollo510 TPIU is enabled and data can be streamed out trace data from ARM ITM and ETM modules through TRACEDATA ports</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable the TPIU TRACE.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable the TPIU TRACE.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>OTAPOINTER</name>
          <description>OTA (Over the Air) Update Pointer/Status. Reset only by POA</description>
          <addressOffset>0x00000264</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>OTAPOINTER</name>
              <description>Flash page pointer with updated OTA image</description>
              <bitRange>[31:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OTASBLUPDATE</name>
              <description>Indicates that the sbl_init has been updated</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OTAVALID</name>
              <description>Indicates that an OTA update is valid</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>APBDMACTRL</name>
          <description>DMA Control Register. Determines misc settings for DMA operation</description>
          <addressOffset>0x00000280</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000203</resetValue>
          <resetMask>0x0000FF03</resetMask>

          <fields>
            <field>
              <name>HYSTERESIS</name>
              <description>This field determines how long the DMA engine of apb/disp/gfx will remain active during deep sleep before shutting down and returning the system to full deep sleep. Values are based on a 94KHz clock and are roughly 10us increments for a range of ~10us to 2.55ms</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>DECODEABORT</name>
              <description>APB Decode Abort. When set, the APB bridge will issue a data abort (bus fault) on transactions to peripherals that are powered down. When set to 0, writes are quietly discarded and reads return 0.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Bus operations to powered down peripherals are quietly discarded</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Bus operations to powered down peripherals result in a bus fault.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMAENABLE</name>
              <description>Enable the DMA controller. When disabled, DMA requests will be ignored by the controller</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>DMA operations disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DMA operations enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FORCEAXICLKEN</name>
          <description>Force AXI Clock Enabled</description>
          <addressOffset>0x00000284</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>

          <fields>
            <field>
              <name>FRCAXICLKEN</name>
              <description>This bit will override the AXI fabric clock enable logic to force it on.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>KEXTCLKSEL</name>
          <description>Locks the state of the EXTCLKSEL register from writes. This is done to prevent errant writes to the register, as this could cause the chip to halt. Write a value of 0x53 to unlock write access to the EXTCLKSEL register. Once unlocked, the register will read back a 1 to undicate this is unlocked. Writing the register with any other value other than 0x53 will enable the lock.</description>
          <addressOffset>0x00000338</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>KEXTCLKSEL</name>
              <description>Key register value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Key</name>
                  <description>Key value to unlock the register.</description>
                  <value>83</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SIMOBUCK0</name>
          <description>This WRITE_ONLY register controls various buck parameters. It will read back as 0x00000000.</description>
          <addressOffset>0x0000033C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000001F</resetMask>

          <fields>
            <field>
              <name>TONTOFFNODEGLITCH</name>
              <description>Enable the ton and toff signals no deglitch output.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VDDCLVRXCOMPEN</name>
              <description>Enable the VDDC LV rail.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VDDSRXCOMPEN</name>
              <description>Enable the VDDS rail.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VDDFRXCOMPEN</name>
              <description>Enable the VDDS rail.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>VDDCRXCOMPEN</name>
              <description>Enable the VDDC rail.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SIMOBUCK1</name>
          <description>1. Control the even division of 3 clocks: refresh, low power and TONCLK. 2. Control gap bewteen secondary switches. 3. Debug features: control the amount of time TONCLK is on, and the time before snubber asserts for each buck sequence. 4. Enable or disable the observation bus. 5. Select the buck sequence operation mode. 6. Control delay between primary Pmos and Nmos transitions.</description>
          <addressOffset>0x00000340</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00400000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>SIMOBUCKHPTRIMEN</name>
              <description>Enable the simobuck HP mode trim</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SIMOBUCK_HP_OFF</name>
                  <description>Disable simobuck hp trim.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIMOBUCK_HP_ON</name>
                  <description>Enable simobuck hp trim.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SIMOBUCKOBSEN</name>
              <description>Enable the simobuck observation bus output.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SIMO_DATA_OFF</name>
                  <description>Disable simobuck data output.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIMO_DATA_ON</name>
                  <description>Enable simobuck data output.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BUCKMODE</name>
              <description>The buck sequence can operate in two buck sequence modes: default (zxcomp) and backup. Set before simobuck comes up.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ZXCOMP</name>
                  <description>Select default (ZXCOMP) sequence operating mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOZXCOMP</name>
                  <description>Select backup sequence operating mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FORCEBUCKOFF</name>
              <description>Control the buck sequence stopping point before snubber asserts. Set before simobuck comes up.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VARIED_CYCLES</name>
                  <description>Stop point will vary depending on operating mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWO_CYCLE</name>
                  <description>Stop exactly 1 TONCLK cycle before snubber asserts.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TPNDTRIM</name>
              <description>Control delay between primary Pmos and Nmos transitions.</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>TONCLKTRIM</name>
              <description>This divides the 100 MHz ton clock. Even divides are supported only. This value represents the division amount minus 1.</description>
              <bitRange>[25:22]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>WSELVDDSBSMODE</name>
              <description>DEPRECATED</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>WSELDELAYTRIM</name>
              <description>DEPRECATED</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXSCHEDULINGCODE</name>
              <description>DEPRECATED</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>OBSMODE</name>
              <description>Choose from 4 modes of operation</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCLKLPTRIM</name>
              <description>This divides the 32 kHz low power clock. Even divides are supported only. This value represents the division amount minus 1.</description>
              <bitRange>[15:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCLKACTTRIM</name>
              <description>This divides the 5 MHz refresh clock. Even divides are supported only. This value represents the division amount minus 1.</description>
              <bitRange>[10:6]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>RXCLKACTSEL</name>
              <description>DEPRECATED</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>LPFBEN</name>
              <description>DEPRECATED</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>FORCETONCLKEN</name>
              <description>TONCLK is active only when needed to save power. This keeps the clock always on (AON). Set before simobuck comes up.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LP_TONCLK</name>
                  <description>TONCLK will be active only when needed.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AON_TONCLK</name>
                  <description>TONCLK is always on.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DCMMODEEN</name>
              <description>DEPRECATED</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>COARSESEL</name>
              <description>DEPRECATED</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>ACTFBEN</name>
              <description>DEPRECATED</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>SIMOBUCK2</name>
