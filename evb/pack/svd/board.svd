        <value>8</value>
      </interrupt>
    </peripheral>    <peripheral derivedFrom="IOM0">
      <name>IOM3</name>
      <baseAddress>0x40053000</baseAddress>
      <interrupt>
        <name>IOMSTR3</name>
        <description>IOMSTR3_IRQ</description>
        <value>9</value>
      </interrupt>
    </peripheral>    <peripheral derivedFrom="IOM0">
      <name>IOM4</name>
      <baseAddress>0x40054000</baseAddress>
      <interrupt>
