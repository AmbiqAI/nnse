          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE2</name>
              <description>Auto DMA Request Size for USB DMA request line 2</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE3</name>
          <description>Auto DMA Request Size 3</description>
          <addressOffset>0x0000240C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE3</name>
              <description>Auto DMA Request Size for USB DMA request line 3</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE4</name>
          <description>Auto DMA Request Size 4</description>
          <addressOffset>0x00002410</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE4</name>
              <description>Auto DMA Request Size for USB DMA request line 4</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE5</name>
          <description>Auto DMA Request Size 5</description>
          <addressOffset>0x00002414</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE5</name>
              <description>Auto DMA Request Size for USB DMA request line 5</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE6</name>
          <description>Auto DMA Request Size 6</description>
          <addressOffset>0x00002418</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE6</name>
              <description>Auto DMA Request Size for USB DMA request line 6</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE7</name>
          <description>Auto DMA Request Size 7</description>
          <addressOffset>0x0000241C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE7</name>
              <description>Auto DMA Request Size for USB DMA request line 7</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>ADMAREQSIZE8</name>
          <description>Auto DMA Request Size 8</description>
          <addressOffset>0x00002420</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>

          <fields>
            <field>
              <name>ADMAREQSIZE8</name>
              <description>Auto DMA Request Size for USB DMA request line 8</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>

