        <register>
          <name>BOOTTOCTRL</name>
          <description>Boot Data Timeout control</description>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>

          <fields>
            <field>
              <name>BOOTDATATO</name>
              <description>This value determines the interval by which DAT line time-outs are detected during boot operation for eMMC card. The value is in number of sd clock.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>

            </field>
          </fields>
        </register>
        <register>
          <name>VENDOR</name>
          <description>Vendor</description>
          <addressOffset>0x00000078</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>

          <fields>
            <field>
              <name>DLYDIS</name>
              <description>Chicken bit added to enable/disable the rtl fix made to delay the sampling of cmd_in and data_in.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the rtl fix made to delay the sampling of cmd_in and data_in</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable the rtl fix made to delay the sampling of cmd_in and data_in</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GATESDCLKEN</name>
              <description>If this bit is 0, SD_CLK to card will not be gated automatically, when there is no transfer. If this bit set to 1, SD_CLK to card will be gated automatically,when there is no transfer.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GATE</name>
                  <description>SD_CLK to card will be gated automatically when there is no transfer.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOGATE</name>
                  <description>SD_CLK to card will NOT be gated automatically when there is no transfer.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
