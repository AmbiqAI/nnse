                  <name>DEFEATURE</name>
                  <description>Chicken bit to revert to rev A</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRONCLKENDISP</name>
              <description>Chicken bit to disable Rev B clock enable during reset</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISPCLKENRST</name>
                  <description>Enable Display Clock to run during reset</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEFEATURE</name>
                  <description>Chicken bit to revert to rev A</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FRCHFRC2</name>
              <description>Force HFRC2 On.When changing a module's clock source to HFRC2, this bit must be set before changing the MUX select to HFRC2 and then cleared after setting the MUX select to HFRC2.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOFRC</name>
                  <description>Do not force HFRC2 on; stops in deep sleep mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FRC</name>
                  <description>Force HFRC2 on; runs in deep sleep mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FRCBURSTOFF</name>
              <description>Force fclk, hclk, fclk_wic and fclk_pmu to be turned off during burst transition.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BURSTCLKON</name>
                  <description>fclk, hclk and fclk_wic are turned on during the burst transition</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURSTCLKOFF</name>
                  <description>fclk, hclk and fclk are turned off during burst transition</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FRCHFRC</name>
              <description>Force HFRC On .</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOFRC</name>
                  <description>HFRC stops in deep sleep mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FRC</name>
                  <description>HFRC runs in deep sleep mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
