              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Disable clock gate</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Enable clock gate</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
