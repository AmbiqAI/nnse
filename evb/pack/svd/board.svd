                </enumeratedValue>
                <enumeratedValue>
                  <name>SHL1</name>
                  <description>SHL1 opcode</description>
                  <value>15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MULLOW</name>
                  <description>MulLow opcode</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
