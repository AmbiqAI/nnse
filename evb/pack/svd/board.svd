        <register>
          <name>TIMER11</name>
          <description>This register holds the running time or event count for timer 11.</description>
          <addressOffset>0x00000364</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
