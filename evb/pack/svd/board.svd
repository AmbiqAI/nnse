                <enumeratedValue>
                  <name>16b</name>
                  <description>Receive audio sample length is 16 bits for phase 2.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20b</name>
                  <description>Receive audio sample length is 20 bits for phase 2.</description>
                  <value>3</value>
