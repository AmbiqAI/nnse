        <register>
          <name>CORECFG1</name>
          <description>PDM to PCM Extra Configuration</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000007</resetValue>
          <resetMask>0x000000FF</resetMask>

          <fields>
