            </field>
            <field>
              <name>SSZ1</name>
              <description>Receive audio sample length for phase 1.  0: 8b, 1: 12b, 2: 16b, 3: 20b, 4: 24b, 5: 32b, 6,7: Reserved</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8b</name>
                  <description>Receive audio sample length is 8 bits for phase 1.</description>
                  <value>0</value>
