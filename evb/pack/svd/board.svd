              <bitRange>[20:20]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNORESDIO1</name>
              <description>Ignore SDIO1</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREDBG</name>
              <description>Ignore DBG</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREAUD</name>
              <description>Ignore AUD</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREUSBPHY</name>
              <description>Ignore USB PHY</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREUSB</name>
              <description>Ignore USB Control</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNORESDIO0</name>
              <description>Ignore SDIO0</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNORECRYPTO</name>
              <description>Ignore CRYPTO</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREDISPPHY</name>
              <description>Ignore DISP PHY</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREDISP</name>
              <description>Ignore DISP Control</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREGFX</name>
              <description>Ignore GFX</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>

            </field>
            <field>
              <name>IGNOREHCPE</name>
